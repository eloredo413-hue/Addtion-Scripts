-- Replaces exact text (no patterns) once.
local function applyPatches(src, patches, label)
    for _, patch in ipairs(patches or {}) do
        local i, j = string.find(src, patch.old, 1, true)
        if i then
            src = string.sub(src, 1, i - 1) .. patch.new .. string.sub(src, j + 1)
        else
            warn("[Loader] " .. tostring(label) .. " changed: its " .. patch.name .. " lag fix was not applied")
        end
    end
    return src
end

-- url is one link or a list of links tried in order; a download that is an error page
-- ("404: Not Found" or HTML) or does not compile moves on to the next link.
local function loadUrl(url, label, patches)
    local urls = type(url) == "table" and url or { url }
    for _, u in ipairs(urls) do
        local ok, src = pcall(game.HttpGet, game, u)
        if ok and type(src) == "string" and #src > 20 and not src:find("^%s*<") and not src:find("^%s*%d%d%d:") then
            local chunk = loadstring(applyPatches(src, patches, label))
            if chunk then return pcall(chunk) end
        end
    end
    warn("[Loader] could not load " .. (label or urls[1]:match("[^/]+$")))
    return false
end

