local function patchMoreGuis(src)
    local url2017 = string.match(src, 'local URL_2017%s*=%s*"([^"]*)"')
    if url2017 then gui2017Url = url2017 end
    for name, url in pairs(MORE_GUIS_SWAPS) do
        local a, b = string.find(src, "local " .. name .. '%s*=%s*"[^"]*"')
        if a then
            src = string.sub(src, 1, a - 1) .. "local " .. name .. ' = "' .. url .. '"' .. string.sub(src, b + 1)
        else
            warn("[Loader] More guis: " .. name .. " wasn't found, so it keeps its own link")
        end
    end
    return src
end

-- patch (optional): changes the downloaded code before it runs
local function loadUrl(url, label, patch)
    local ok, src = pcall(game.HttpGet, game, url)
    if not ok or type(src) ~= "string" then return false end
    if patch then src = patch(src) end
    local chunk = loadstring(src)
    if not chunk then return false end
    return pcall(chunk)
end

