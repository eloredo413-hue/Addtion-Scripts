--========================================================
-- SYSTEM INJECTORS
--========================================================
task.spawn(function()
    local player = Players.LocalPlayer
    local pg = player:WaitForChild("PlayerGui")

    local dialogLoaded_Classic = false

    -- Text of a saved choice: a string, or (if the config stores a table) its string values.
    local function choiceText(value)
        if type(value) == "string" then return value end
        if type(value) == "table" then
            local parts = {}
            for _, v in pairs(value) do
                if type(v) == "string" then table.insert(parts, v) end
            end
            return table.concat(parts, " ")
        end
        return nil
    end

    -- classic    = 2011-2014 / mobile (our 2011-style bubbles and dialogs)
    -- y2010      = 2010 (its GUI draws its own chat bubbles, so none of ours), and 2008 (the 2010
    --              GUI without chat bubbles: none of ours either)
    -- bubble2017 = 2015 / 2016 (they use the 2017 bubbles)
    -- modern     = 2017-2020
    -- none       = anything else (no GUI selected): nothing is touched
    -- (2015 early, 2008, 2006 and 2005 are told apart at Confirm: see TOPBAR_VARIANTS below)
    -- 2015 / 2016 win when the text names one of them (a label such as "2016 (2014 style)" is
    -- 2016); the classic years and "mobile" only decide when no 2015 / 2016 is named.
    local function classifyEra(text)
        local s = string.lower(text or "")
        if s:find("2015", 1, true) or s:find("2016", 1, true) then return "bubble2017" end
        if s:match("^%s*2010%s*$") then return "y2010" end
        if s:find("2010", 1, true) or s:find("2011", 1, true) or s:find("2012", 1, true)
           or s:find("2013", 1, true) or s:find("2014", 1, true) or s:find("mobile", 1, true) then
            return "classic"
        end
        if s:find("2017", 1, true) or s:find("2018", 1, true) or s:find("2019", 1, true) or s:find("2020", 1, true) then
            return "modern"
        end
        return "none"
    end

    local function getSelectedEra()
        local actual = "none"
        pcall(function()
            if readfile and isfile and isfile("BloxyParadoxConfig.json") then
                local cfg = HttpService:JSONDecode(readfile("BloxyParadoxConfig.json"))
                actual = (cfg.Choices and cfg.Choices.Topbar) or cfg.Topbar or cfg.topbar or cfg.TopbarChoice or cfg.TopbarID or "none"
            end
        end)

        local text = choiceText(actual)
        if not text then return "none", tostring(actual) end
        return classifyEra(text), text
    end

    local TextChatService = game:GetService("TextChatService")
    local nativeBubblesHidden = false
    local hiddenNativeBubbles = {}
    local savedBubbleEnabled = nil

    local function sweepNativeBubbles()
        pcall(function()
            for _, obj in ipairs(CoreGui:GetDescendants()) do
                if obj:IsA("BillboardGui") and obj.Enabled
                   and not obj:GetAttribute("ClassicOwned")
                   and string.find(string.lower(obj.Name), "bubble", 1, true) then
                    obj.Enabled = false
                    hiddenNativeBubbles[obj] = true
                end
            end
        end)
    end

    local function setNativeBubbles(hide)
        if hide then
            nativeBubblesHidden = true
            pcall(function()
                local cfg = TextChatService:FindFirstChildOfClass("BubbleChatConfiguration")
                if cfg then
                    if savedBubbleEnabled == nil then savedBubbleEnabled = cfg.Enabled end
                    cfg.Enabled = false
                end
            end)
            sweepNativeBubbles()
        elseif nativeBubblesHidden then
            nativeBubblesHidden = false
            pcall(function()
                local cfg = TextChatService:FindFirstChildOfClass("BubbleChatConfiguration")
                if cfg and savedBubbleEnabled ~= nil then cfg.Enabled = savedBubbleEnabled end
                savedBubbleEnabled = nil
            end)
            for obj in pairs(hiddenNativeBubbles) do
                pcall(function() obj.Enabled = true end)
            end
            hiddenNativeBubbles = {}
        end
    end

    -- status for the console only (no message on screen)
    local function showNote(text, isProblem)
        if isProblem then
            warn("[Loader] " .. text)
        else
            print("[Loader] " .. text)
        end
    end

    --========================================================
    -- CLASSIC CHAT BUBBLES (2011-2014 / mobile)
    -- White bubbles over players' heads, built into this loader. A new message goes at the
    -- bottom with the tail; the player's older messages stay stacked above it with grey text.
    -- No fading: bubbles appear and disappear at once, like 2011.
    --========================================================
    local function startClassicBubbles()
        if getgenv().ClassicBubbleCleanup then pcall(getgenv().ClassicBubbleCleanup) end

        local Chat = game:GetService("Chat")

        local BUBBLE_NAME = "__CLASSIC_2011_BUBBLE"
        local MAX_DISTANCE = 75
        local DOT_DISTANCE = 52          -- farther than this: the newest bubble shows "..."
        -- How long a message stays up is Roblox's own rule from its bubble chat script (BubbleChat.lua):
        -- your own messages 8 s (a short one) to 15 s (75 characters or more), other players' 12 to
        -- 20 s. It used to be 20 s for everything, the longest of those. No fade, like 2011.
        local function bubbleLifetime(text, isSelf)
            local t = math.min(#text / 75, 1)
            if isSelf then return 8 + 7 * t end
            return 12 + 8 * t
        end
        local MAX_BUBBLES = 3            -- messages shown at once per player
        local BUBBLE_GAP = 0             -- the bubble picture's own edge already leaves a gap between stacked bubbles
        -- The 2014 bubble (measured on a 2014 screenshot): Arial 22 in a tight bubble with a soft grey edge, and a
        -- tail whose edge runs straight on from the bubble's. These are the sizes of 2011-2014 Dialogs and Chat as first
        -- published (the bubbles in the 2014 screenshots): the bubble picture at slice 0.5, and the 18 x 21 tail with its
        -- top 8 px up into the frame, where the white ends, so the grey edge bends into the tail and no corner or white
        -- connector shows. (A thinner edge, or the tail lower, left a white notch with square corners where they meet,
        -- worst on small bubbles.) Small bubbles keep the narrow 42 frame, so the edge runs down into the tail like a
        -- funnel. A faint stroke makes the letters as heavy as 2014's.
        local FONT_SIZE = 22
        local MAX_WIDTH = 240            -- where long messages wrap
        local PAD_X, PAD_Y = 24, 22      -- the bubble frame is the text's size plus these
        local TEXT_Y = 11                -- the text's top inside the bubble frame
        local BODY_SLICE_SCALE = 0.5     -- the bubble picture's corners and edge (the tail's join is made for 0.5)
        local MIN_WIDTH = 42             -- the narrowest bubble frame
        local TEXT_STROKE = 0.8          -- a faint outline on the letters: as heavy as the 2014 text (1 = none)
        local TAIL_OVERLAP = 8           -- how far the tail's top goes up into the bubble frame
        local TAIL_WIDTH, TAIL_HEIGHT = 18, 21
        local DOTS_WIDTH, DOTS_HEIGHT = 52, FONT_SIZE + PAD_Y
        local TEXT_COLOR = Color3.fromRGB(0, 0, 0)
        local OLD_TEXT_COLOR = Color3.fromRGB(160, 160, 160)

        local running = true
        local connections = {}
        local stacks = {}                -- player -> { gui, head, tail, entries, far, connection }
        local lastMessages = {}

        -- every stack's near / far check in one update, 10 times a second (it was one callback per player, every frame)
        local stackSteps = {}
        local stackDriver = nil
        local stackAcc = 0
        local function onStackStep(step)
            stackSteps[step] = true
            if not stackDriver then
                stackDriver = RunService.RenderStepped:Connect(function(dt)
                    stackAcc = stackAcc + (dt or 0)
                    if stackAcc < 0.1 then return end
                    stackAcc = 0
                    for fn in pairs(stackSteps) do fn() end
                end)
                table.insert(connections, stackDriver)
            end
            return { Disconnect = function() stackSteps[step] = nil end }
        end

        -- the old (legacy) bubble chat is switched off while these bubbles run
        local savedLegacyBubbles = nil
        pcall(function()
            savedLegacyBubbles = Chat.BubbleChatEnabled
            Chat:SetBubbleChatEnabled(false)
        end)

        -- a player's character (not an NPC, so NPC dialog icons are never touched)
        local function playerCharacterOf(object)
            local current = object
            while current and current ~= game do
                if current:IsA("Model") and Players:GetPlayerFromCharacter(current) then return current end
                current = current.Parent
            end
            return nil
        end

        -- Only BillboardGuis are chat bubbles. A SurfaceGui is never one, and was being deleted
        -- along with them (the 2006 avatar's T-shirt is a SurfaceGui on the torso, so it never
        -- stayed). Guis marked ClassicOwned, and the health bars from Hammer stuff 2, are left alone.
        local KEEP_NAMES = { CustomExecutorHealth = true }
        local function isForeignBubble(object)
            return object.ClassName == "BillboardGui"
                and object.Name ~= BUBBLE_NAME
                and not KEEP_NAMES[object.Name]
                and not object:GetAttribute("ClassicOwned")
        end

        local function belongsToPlayerCharacter(object)
            if object.Adornee and playerCharacterOf(object.Adornee) then return true end
            return playerCharacterOf(object) ~= nil
        end

        -- other bubble guis on a player's character (the game's own chat bubbles)
        local function removeCharacterBubbles(character)
            if not character then return end
            for _, object in ipairs(character:GetDescendants()) do
                if isForeignBubble(object) then pcall(function() object:Destroy() end) end
            end
        end

        -- places the bubbles from the bottom up; the newest one sits on the tail
        local function layout(stack)
            local entries = stack.entries
            local count = #entries
            if count == 0 then return end

            if stack.far then
                for i, entry in ipairs(entries) do
                    local newest = i == count
                    entry.frame.Visible = newest
                    if newest then
                        entry.label.Text = "..."
                        entry.label.Size = UDim2.new(1, -16, 0, FONT_SIZE)
                        entry.label.Position = UDim2.new(0, 8, 0, TEXT_Y)
                        entry.frame.Size = UDim2.new(0, DOTS_WIDTH, 0, DOTS_HEIGHT)
                        entry.frame.Position = UDim2.new(0.5, -DOTS_WIDTH / 2, 0, 0)
                    end
                end
                stack.gui.Size = UDim2.new(0, DOTS_WIDTH, 0, DOTS_HEIGHT + TAIL_HEIGHT)
                stack.tail.Position = UDim2.new(0.5, -TAIL_WIDTH / 2, 0, DOTS_HEIGHT - TAIL_OVERLAP)
                return
            end

            local width, total = 0, 0
            for i, entry in ipairs(entries) do
                width = math.max(width, entry.width)
                total = total + entry.height
                if i > 1 then total = total + BUBBLE_GAP end
            end
            stack.gui.Size = UDim2.new(0, width, 0, total + TAIL_HEIGHT)

            local y = total
            for i = count, 1, -1 do
                local entry = entries[i]
                y = y - entry.height
                entry.frame.Visible = true
                entry.frame.Size = UDim2.new(0, entry.width, 0, entry.height)
                entry.frame.Position = UDim2.new(0.5, -entry.width / 2, 0, y)
                entry.label.Text = entry.text
                entry.label.Size = UDim2.new(0, entry.textWidth, 0, entry.textHeight)
                entry.label.Position = UDim2.new(0.5, -entry.textWidth / 2, 0, TEXT_Y)
                y = y - BUBBLE_GAP
            end
            stack.tail.Position = UDim2.new(0.5, -TAIL_WIDTH / 2, 0, total - TAIL_OVERLAP)
        end

        local function destroyStack(player)
            local stack = stacks[player]
            if not stack then return end
            stacks[player] = nil
            if stack.connection then stack.connection:Disconnect() end
            pcall(function() stack.gui:Destroy() end)
        end

        local function removeEntry(stack, entry)
            if entry.removed then return end
            entry.removed = true
            local index = table.find(stack.entries, entry)
            if index then table.remove(stack.entries, index) end
            pcall(function() entry.frame:Destroy() end)
            if stacks[stack.player] ~= stack then return end
            if #stack.entries == 0 then
                destroyStack(stack.player)
            else
                layout(stack)
            end
        end

        local function getStack(player, head)
            local existing = stacks[player]
            if existing and existing.head == head and existing.gui.Parent then return existing end
            destroyStack(player)

            for _, object in ipairs(head:GetChildren()) do
                if object.Name == BUBBLE_NAME then object:Destroy() end
            end

            local gui = Instance.new("BillboardGui")
            gui.Name = BUBBLE_NAME
            gui.Adornee = head
            gui.Size = UDim2.new(0, DOTS_WIDTH, 0, DOTS_HEIGHT + TAIL_HEIGHT)
            gui.StudsOffset = Vector3.new(0, 2.5, 0)
            gui.SizeOffset = Vector2.new(0, 0.5)
            gui.MaxDistance = MAX_DISTANCE
            gui.AlwaysOnTop = false
            gui.ZIndexBehavior = Enum.ZIndexBehavior.Global

            local tail = Instance.new("ImageLabel")
            tail.Name = "Tail"
            tail.BackgroundTransparency = 1
            tail.Image = "rbxassetid://2582470060"
            tail.Size = UDim2.new(0, TAIL_WIDTH, 0, TAIL_HEIGHT)
            tail.ZIndex = 4
            tail.Parent = gui

            local connector = Instance.new("Frame")
            connector.Name = "Connector"
            connector.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            connector.BorderSizePixel = 0
            connector.Size = UDim2.new(0, 10, 0, 6)
            connector.Position = UDim2.new(0.5, -5, 0, -4)
            connector.ZIndex = 3
            connector.Parent = tail

            local stack = { player = player, gui = gui, head = head, tail = tail, entries = {}, far = false }

            stack.connection = onStackStep(function()
                if not gui.Parent then
                    if stacks[player] == stack then destroyStack(player) else stack.connection:Disconnect() end
                    return
                end
                local cam = Workspace.CurrentCamera
                if not cam then return end
                local far = (cam.CFrame.Position - head.Position).Magnitude > DOT_DISTANCE
                if far ~= stack.far then
                    stack.far = far
                    layout(stack)
                end
            end)

            stacks[player] = stack
            gui.Parent = head
            return stack
        end

        local function createBubble(player, text)
            local character = player.Character
            local head = character and character:FindFirstChild("Head")
            if not head then return end
            removeCharacterBubbles(character)

            local stack = getStack(player, head)

            -- older messages stay above, with grey text
            for _, old in ipairs(stack.entries) do
                old.label.TextColor3 = OLD_TEXT_COLOR
                old.label.TextStrokeColor3 = OLD_TEXT_COLOR
            end
            -- too many: the oldest goes
            while #stack.entries >= MAX_BUBBLES do
                removeEntry(stack, stack.entries[1])
            end

            local measured = TextService:GetTextSize(text, FONT_SIZE, Enum.Font.Arial, Vector2.new(MAX_WIDTH, 1000))
            -- The text is drawn exactly as wide as it was measured (a hair over, never past the wrap width), so it
            -- wraps the same way it was measured. It used to be drawn in the whole bubble less 16: 8 px wider than
            -- the measured wrap on long messages, so a word more fitted on a line and that line ran into the grey edge.
            -- (The bubble itself is as wide as before.)
            local textWidth = math.min(math.ceil(measured.X) + 2, MAX_WIDTH)

            local frame = Instance.new("Frame")
            frame.Name = "Bubble"
            frame.BackgroundTransparency = 1

            local body = Instance.new("ImageLabel")
            body.Name = "Body"
            body.BackgroundTransparency = 1
            body.Image = "rbxassetid://2582470061"
            body.ScaleType = Enum.ScaleType.Slice
            body.SliceCenter = Rect.new(29, 29, 67, 67)
            body.SliceScale = BODY_SLICE_SCALE
            body.Size = UDim2.new(1, 0, 1, 0)
            body.ZIndex = 2
            body.Parent = frame

            local label = Instance.new("TextLabel")
            label.Name = "Text"
            label.BackgroundTransparency = 1
            label.FontFace = Font.new("rbxasset://fonts/families/Arial.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
            label.TextSize = FONT_SIZE
            label.TextColor3 = TEXT_COLOR
            label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            label.TextStrokeTransparency = TEXT_STROKE
            label.TextWrapped = true
            label.Text = text
            label.ZIndex = 10
            label.Parent = frame

            local entry = {
                text = text,
                width = math.clamp(measured.X + PAD_X, MIN_WIDTH, MAX_WIDTH + PAD_X),
                textWidth = textWidth,
                height = measured.Y + PAD_Y,
                textHeight = measured.Y,
                frame = frame,
                label = label,
            }
            table.insert(stack.entries, entry)
            frame.Parent = stack.gui
            layout(stack)

            task.delay(bubbleLifetime(text, player == Players.LocalPlayer), function() removeEntry(stack, entry) end)
        end

        local function receiveMessage(player, text)
            if not running or not player then return end
            if typeof(text) ~= "string" or text == "" then return end
            -- the same message can arrive through both chat systems
            local key = tostring(player.UserId) .. ":" .. text
            if lastMessages[key] then return end
            lastMessages[key] = true
            task.delay(0.25, function() lastMessages[key] = nil end)
            createBubble(player, text)
        end

        local function hookPlayer(player)
            table.insert(connections, player.Chatted:Connect(function(text)
                receiveMessage(player, text)
            end))
            table.insert(connections, player.CharacterAdded:Connect(function(character)
                task.wait(0.2)
                if running then removeCharacterBubbles(character) end
            end))
        end
        for _, player in ipairs(Players:GetPlayers()) do hookPlayer(player) end
        table.insert(connections, Players.PlayerAdded:Connect(hookPlayer))
        table.insert(connections, Players.PlayerRemoving:Connect(destroyStack))

        pcall(function()
            table.insert(connections, TextChatService.MessageReceived:Connect(function(message)
                if not message or not message.TextSource then return end
                receiveMessage(Players:GetPlayerByUserId(message.TextSource.UserId), message.Text)
            end))
        end)

        -- the game's own bubbles on player characters are removed as soon as they appear
        local function watchContainer(container)
            table.insert(connections, container.DescendantAdded:Connect(function(object)
                if not isForeignBubble(object) then return end
                task.defer(function()
                    if running and object.Parent and belongsToPlayerCharacter(object) then
                        pcall(function() object:Destroy() end)
                    end
                end)
            end))
        end
        watchContainer(Workspace)
        watchContainer(pg)

        -- One sweep now (bubbles already on screen); after that new ones are caught the moment
        -- they appear (above), so only a slow safety sweep of the characters is left. This used to
        -- scan every player's character and the whole PlayerGui more than six times a second.
        task.spawn(function()
            pcall(function()
                for _, object in ipairs(pg:GetDescendants()) do
                    if isForeignBubble(object) and belongsToPlayerCharacter(object) then object:Destroy() end
                end
            end)
            while running do
                for _, player in ipairs(Players:GetPlayers()) do
                    removeCharacterBubbles(player.Character)
                end
                task.wait(3)
            end
        end)

        local function cleanup()
            running = false
            for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
            connections = {}
            for player in pairs(stacks) do destroyStack(player) end
            if savedLegacyBubbles ~= nil then
                pcall(function() Chat:SetBubbleChatEnabled(savedLegacyBubbles) end)
            end
            if getgenv().ClassicBubbleCleanup == cleanup then getgenv().ClassicBubbleCleanup = nil end
        end
        getgenv().ClassicBubbleCleanup = cleanup
        return cleanup
    end

    --========================================================
    -- OLD-STYLE SPEEDOMETER (2010-2014 AND 2015 EARLY), AND NO MODERN ONE BEFORE 2015
    -- A solid blue bar with "Speed: 46" under it, as in the old car HUD of https://youtu.be/HgcfN5V0I-4.
    -- From frames of a screen recording of it: the bar is plain blue, no background, always at the same
    -- place on the screen (centred, a little below the middle), and its width grows with the speed,
    -- roughly 7 pixels for every point of speed on a 720p screen; the text is small, plain blue, no
    -- outline, centred under it. It is a screen GUI, not attached to the player or the car.
    --   * The modern speedometer only shows from 2015 on. In every era up to 2015 early it is switched off
    --     (and kept off if it is switched on again): Roblox's own vehicle speed display (the "Speed 0"
    --     with a segmented bar at the bottom, CoreGui.RobloxGui.VehicleHudFrame), the game's own
    --     readout and the GUI around it that is named like a speedometer, and any GUI named like one
    --     (Speedometer, SpeedoFrame ...). A dashboard on the car is left alone. 2015 and later get
    --     the modern one back untouched.
    --   * 2010-2014 (2010, 2011-2014, mobile) and 2015 early get this old one in its place, while driving: whatever the
    --     game has. If the game has a visible speed readout, its number is shown (so the units match),
    --     else the car's own speed. 2005 and 2006 have no speedometer at all.
    --   * Only while you are sitting in a VehicleSeat (another seat once it moves).
    --   * "Hide game GUI" leaves it alone (it is in the hidden-UI container, and is told to keep it).
    --   * What it found is printed to the console.
    -- (Addtion-Scripts) A little higher than in the recording (48% down the screen, not 55%), so on a phone it
    -- doesn't cover 2015 early's inventory arrow.
    -- Redrawn every frame and the bar eases toward its width, so it moves smoothly. On purpose
    -- the original's stretch: about 7 pixels for each point of speed, up to 90% of the screen's width (it had
    -- been held to 5 pixels a point and 300 wide to fit a phone; the original kept getting wider).
    --========================================================
    -- mode: "show" = the old speedometer, and the game's own switched off; "hideOnly" = only the game's
    -- own switched off (2005 / 2006: no speedometer at all)
    local function startSpeedometer(mode)
        mode = mode or "show"
        if getgenv().SpeedometerCleanup then
            if getgenv().SpeedometerMode == mode then return end   -- already on, the same way
            pcall(getgenv().SpeedometerCleanup)
        end
        local showOurs = mode == "show"

        local LocalPlayer = Players.LocalPlayer
        local BLUE = Color3.fromRGB(0, 0, 255)
        local PIXELS_PER_SPEED = 7       -- the original: about 7 on a 720p screen
        local MAX_BAR_SHARE = 0.9         -- (Addtion-Scripts) at most 90% of the screen's width (it used to stop at 300)
        local MIN_BAR = 3                -- so it can be seen at a standstill
        local BAR_HEIGHT = 12
        local EASE = 14                  -- how fast the bar follows (per second)
        local running = true
        local connections = {}
        local display = nil      -- { gui, bar, label, seat, beat, clock, readout, nextCheck, width, shownNumber }

        -- is this label a speed readout, and is it on screen?
        local SPEED_WORDS = { "speed", "mph", "km/h", "kmh", "kph", "m/s", "studs/s", "velocity", "spd" }
        local function mentionsSpeed(text)
            text = string.lower(text or "")
            for _, word in ipairs(SPEED_WORDS) do
                if string.find(text, word, 1, true) then return true end
            end
            return false
        end

        -- a title label that only says what the number next to it is: "Speed", "MPH", "km/h" ...
        local TITLE_TEXTS = { speed = true, ["speed:"] = true, spd = true, mph = true, ["km/h"] = true,
                              kmh = true, kph = true, ["m/s"] = true }
        local function isTextLabel(obj)
            local class = obj.ClassName
            return class == "TextLabel" or class == "TextButton"
        end
        local function isTitleLabel(obj)
            if not isTextLabel(obj) then return false end
            local text = string.lower(obj.Text or "")
            text = string.gsub(string.gsub(text, "^%s+", ""), "%s+$", "")
            return TITLE_TEXTS[text] == true
        end
        -- a label that is a number, maybe with a unit after it ("46", "46.5", "46 mph")
        local function isNumberLabel(obj)
            if not isTextLabel(obj) then return false end
            local text = obj.Text or ""
            return #text <= 14 and string.find(text, "^%s*%-?%d") ~= nil
        end
        -- the title next to a number label: a sibling, or a sibling of its parent. Returns the title
        -- and the container that holds both.
        local function findTitleNear(label)
            local container = label.Parent
            for _ = 1, 2 do
                if not container or container:IsA("PlayerGui") then return nil end
                for _, sibling in ipairs(container:GetChildren()) do
                    if sibling ~= label and isTitleLabel(sibling) then return sibling, container end
                end
                if container:IsA("LayerCollector") then return nil end
                container = container.Parent
            end
            return nil
        end

        -- a label with a number in it that says "speed" itself, or sits in something called Speed...
        -- (a GUI named SpeedBar / Speedometer, a Frame called MPH), up to three levels up; or a number
        -- with a "Speed" title next to it
        local function looksLikeSpeedReadout(obj)
            if not isTextLabel(obj) then return false end
            local text = obj.Text or ""
            if not string.find(text, "%d") then return false end
            if mentionsSpeed(text) or mentionsSpeed(obj.Name) then return true end
            local up = obj.Parent
            for _ = 1, 3 do
                if not up or up:IsA("PlayerGui") then break end
                if mentionsSpeed(up.Name) then return true end
                up = up.Parent
            end
            return isNumberLabel(obj) and findTitleNear(obj) ~= nil
        end

        -- the game's own speedometer GUIs that are switched off by this script: target -> { prop, gameWants, conn }
        local held = {}

        -- (a GUI this script switched off is still "on screen" as far as the game is concerned)
        local function isOnScreen(obj)
            local current = obj
            while current and current ~= game do
                if not held[current] then
                    if current:IsA("GuiObject") then
                        if not current.Visible then return false end
                    elseif current:IsA("LayerCollector") then
                        if not current.Enabled then return false end
                    end
                end
                current = current.Parent
            end
            -- a GUI that was taken out of the game is not on screen either
            return current == game
        end

        -- the game's own speed readout: in the player's GUI, or on the car (a dashboard)
        local function findReadout(seat)
            local roots = { pg }
            local car = seat:FindFirstAncestorOfClass("Model")
            if car then table.insert(roots, car) end
            for _, root in ipairs(roots) do
                for _, obj in ipairs(root:GetDescendants()) do
                    if looksLikeSpeedReadout(obj) and isOnScreen(obj)
                       and not (display and obj:IsDescendantOf(display.gui)) then
                        return obj
                    end
                end
            end
            return nil
        end

        -- The game's own speedometer is switched off for as long as this runs (every era up to 2015 early), also
        -- when you are not in a car, and switched off again if the game switches it on. When this stops
        -- (a 2015 or later topbar) the game's own comes back: if you are in a car it is switched on.
        local function holdGame(target, prop)
            if held[target] then return false end
            local up = target.Parent
            while up and up ~= game do          -- something inside one already held is covered by it
                if held[up] then return false end
                up = up.Parent
            end
            local ok = pcall(function()
                local entry = { prop = prop, gameWants = target[prop] }
                entry.conn = target:GetPropertyChangedSignal(prop):Connect(function()
                    if target[prop] == true then
                        entry.gameWants = true
                        target[prop] = false        -- the game switched it on again
                    end
                end)
                held[target] = entry
                target[prop] = false
            end)
            if ok then
                print("[Speedometer] the game's own speedometer is switched off: " .. target:GetFullName())
            end
            return ok
        end

        local function releaseGame()
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local seated = humanoid ~= nil and humanoid.SeatPart ~= nil
            for target, entry in pairs(held) do
                pcall(function() entry.conn:Disconnect() end)
                pcall(function() target[entry.prop] = entry.gameWants and seated end)
            end
            held = {}
        end

        local function propOf(gui) return gui:IsA("LayerCollector") and "Enabled" or "Visible" end

        -- is this GUI small enough to be one gauge, not the whole HUD?
        local function isSmallWidget(gui)
            if gui:IsA("LayerCollector") then return #gui:GetDescendants() <= 12 end
            local camera = workspace.CurrentCamera
            local view = camera and camera.ViewportSize
            if not view then return false end
            local size = gui.AbsoluteSize
            return size.X > 0 and size.X <= view.X * 0.6 and size.Y <= view.Y * 0.3
        end

        -- What to switch off for a readout: the highest thing named like a speedometer within three
        -- levels above it (the same levels the readout is recognised by); else the small container that
        -- holds it and its "Speed" title (the dial or bar in it goes too); else just the readout and
        -- its title. Returns a list of { gui, property }.
        local function speedometerTargets(readout)
            local top = nil
            local up = readout.Parent
            for _ = 1, 3 do
                if not up or up:IsA("PlayerGui") then break end
                if mentionsSpeed(up.Name) then top = up end
                up = up.Parent
            end
            if top then return { { top, propOf(top) } } end
            local title, container = findTitleNear(readout)
            if container and isSmallWidget(container) then return { { container, propOf(container) } } end
            if title then return { { readout, "Visible" }, { title, "Visible" } } end
            return { { readout, "Visible" } }
        end

        -- GUIs named like a speedometer, whether or not they hold a label this can read
        local METER_WORDS = { "speedo", "speedmeter", "speed meter", "speed_meter", "speedgauge", "speed gauge", "speed_gauge" }
        local METER_EXACT = { mph = true, kmh = true, kph = true }
        local function nameSaysMeter(name)
            name = string.lower(name)
            if METER_EXACT[name] then return true end
            for _, word in ipairs(METER_WORDS) do
                if string.find(name, word, 1, true) then return true end
            end
            return false
        end

        -- Roblox's own vehicle speed display (the "Speed 0" with a segmented bar at the bottom of the screen
        -- that shows whenever you sit in a VehicleSeat): its CoreScript VehicleHud makes
        -- CoreGui.RobloxGui.VehicleHudFrame and switches it on when you sit down and off when you leave.
        -- It is not the game's GUI, so nothing in PlayerGui reaches it. Switched off (and kept off) here.
        local vehicleHudHeld = false
        local function switchOffVehicleHud()
            local robloxGui = CoreGui:FindFirstChild("RobloxGui")
            if not robloxGui then return end
            local frame = robloxGui:FindFirstChild("VehicleHudFrame")
            if not frame then
                -- another name for it: a frame with the speed bar and the speed text in it
                for _, child in ipairs(robloxGui:GetChildren()) do
                    if child:FindFirstChild("SpeedBarClippingFrame")
                       or (child:FindFirstChild("SpeedText") and child:FindFirstChild("SpeedLabel")) then
                        frame = child
                        break
                    end
                end
            end
            if frame then
                if not held[frame] then holdGame(frame, "Visible") end
                vehicleHudHeld = held[frame] ~= nil
            end
        end

        -- titles = true (only while driving): also a "Speed" / "MPH" title label with a number label next to
        -- it, and the small container around them (so the bar or dial in it goes too)
        local function switchOffMeters(titles)
            for _, obj in ipairs(pg:GetDescendants()) do
                if not held[obj] and nameSaysMeter(obj.Name) and not obj:GetAttribute("ClassicOwned")
                   and (obj:IsA("GuiObject") or obj:IsA("LayerCollector")) then
                    holdGame(obj, propOf(obj))
                elseif titles and not held[obj] and isTitleLabel(obj) then
                    local container = obj.Parent
                    for _ = 1, 2 do
                        if not container or container:IsA("PlayerGui") or held[container] then break end
                        local hasNumber = false
                        for _, sibling in ipairs(container:GetChildren()) do
                            if sibling ~= obj and isNumberLabel(sibling) then hasNumber = true break end
                        end
                        if hasNumber then
                            if isSmallWidget(container) then holdGame(container, propOf(container)) end
                            break
                        end
                        if container:IsA("LayerCollector") then break end
                        container = container.Parent
                    end
                end
            end
        end

        local function hide()
            if not display then return end
            local shown = display
            display = nil
            pcall(function() shown.beat:Disconnect() end)
            pcall(function() shown.gui:Destroy() end)
            -- Roblox's own speed display of that seat comes back as it was (it is only off while this
            -- runs, i.e. up to 2014)
            if shown.hudSeat then
                pcall(function()
                    if shown.hudSeat:GetAttribute("ClassicHudWas") ~= nil then
                        shown.hudSeat.HeadsUpDisplay = shown.hudSeat:GetAttribute("ClassicHudWas")
                        shown.hudSeat:SetAttribute("ClassicHudWas", nil)
                    end
                end)
            end
        end

        -- Does the game have a speedometer of its own on? Roblox's own (the seat's HeadsUpDisplay was on when
        -- you sat down), or a readout / meter GUI of the game's own that was found and switched off.
        local function gameHasSpeedometer(shown)
            if shown.hudWas == true or shown.readout ~= nil then return true end
            for target in pairs(held) do
                if target:IsDescendantOf(pg) then return true end
            end
            return false
        end

        local function barWidthFor(speed)
            local camera = workspace.CurrentCamera
            local maxBar = camera and camera.ViewportSize.X * MAX_BAR_SHARE or 300
            return math.clamp(speed * PIXELS_PER_SPEED, MIN_BAR, math.max(MIN_BAR, maxBar))
        end

        local function frame(dt)
            local shown = display
            if not shown then return end
            local seat = shown.seat
            if not seat.Parent then hide() return end
            shown.clock = shown.clock + dt

            -- the game's readout: looked for every two seconds while there is none, and checked every
            -- half second while there is one (it can be switched off, or the game can remove it)
            if shown.clock >= shown.nextCheck then
                if shown.readout and not (shown.readout.Parent and isOnScreen(shown.readout)) then
                    shown.readout = nil
                end
                if not shown.readout then
                    shown.readout = findReadout(seat)
                    if shown.readout then
                        print("[Speedometer] the game's speed readout: " .. shown.readout:GetFullName() .. " = \"" .. tostring(shown.readout.Text) .. "\"")
                        if shown.readout:IsDescendantOf(pg) then
                            for _, entry in ipairs(speedometerTargets(shown.readout)) do
                                holdGame(entry[1], entry[2])
                            end
                        end
                    end
                end
                shown.nextCheck = shown.clock + (shown.readout and 0.5 or 2)
            end
            -- GUIs named like a speedometer: looked for every two seconds while driving
            if shown.clock >= shown.nextMeterScan then
                shown.nextMeterScan = shown.clock + 2
                pcall(switchOffMeters, true)
                pcall(switchOffVehicleHud)
            end

            local physical = seat.AssemblyLinearVelocity.Magnitude
            -- only when the game has a speedometer on (getgenv().SpeedometerAlways = true shows it anyway)
            local wanted = getgenv().SpeedometerAlways == true or gameHasSpeedometer(shown)
            local on = showOurs and wanted and (seat:IsA("VehicleSeat") or physical > 3)
            if shown.gui.Enabled ~= on then
                shown.gui.Enabled = on
                shown.justShown = on
            end
            if not on then return end

            -- the game's number if it has one, else the car's speed
            local speed = physical
            local number = shown.readout and tonumber(string.match(shown.readout.Text or "", "%d+%.?%d*"))
            if number then speed = number end

            local target = barWidthFor(speed)
            if shown.justShown then
                shown.width = target          -- no growing from nothing when it appears
                shown.justShown = false
            else
                shown.width = shown.width + (target - shown.width) * (1 - math.exp(-EASE * dt))
            end
            shown.bar.Size = UDim2.new(0, shown.width, 0, BAR_HEIGHT)

            local rounded = math.floor(speed + 0.5)
            if rounded ~= shown.shownNumber then
                shown.shownNumber = rounded
                shown.label.Text = "Speed: " .. rounded
            end
        end

        local function show(seat)
            if display and display.seat == seat then return end
            hide()

            -- a screen GUI, always in the same place: not attached to the player or the car
            local gui = Instance.new("ScreenGui")
            gui.Name = "ClassicSpeedometer"
            gui.ResetOnSpawn = false
            gui.IgnoreGuiInset = true
            gui.DisplayOrder = 5
            gui.Enabled = false
            gui:SetAttribute("ClassicOwned", true)

            local holder = Instance.new("Frame")
            holder.Name = "Holder"
            holder.AnchorPoint = Vector2.new(0.5, 0)
            holder.Position = UDim2.new(0.5, 0, 0.48, 0) -- (Addtion-Scripts) a little higher than the original's 0.55: on a phone it
            -- covered 2015 early's inventory arrow
            holder.Size = UDim2.new(1, 0, 0, 32) -- (the whole width: the bar can stretch across)
            holder.BackgroundTransparency = 1
            holder.BorderSizePixel = 0
            holder.Parent = gui

            local bar = Instance.new("Frame")
            bar.Name = "Bar"
            bar.AnchorPoint = Vector2.new(0.5, 0)
            bar.Position = UDim2.new(0.5, 0, 0, 0)
            bar.Size = UDim2.new(0, 0, 0, BAR_HEIGHT)
            bar.BackgroundColor3 = BLUE
            bar.BorderSizePixel = 0
            bar.Parent = holder

            local label = Instance.new("TextLabel")
            label.Name = "Speed"
            label.AnchorPoint = Vector2.new(0.5, 0)
            label.Position = UDim2.new(0.5, 0, 0, BAR_HEIGHT + 2)
            label.Size = UDim2.new(0, 160, 0, 14)
            label.BackgroundTransparency = 1
            label.Font = Enum.Font.Legacy
            label.TextSize = 11
            label.TextColor3 = BLUE
            label.Text = "Speed: 0"
            label.Parent = holder

            local parentGui = (gethui and gethui()) or CoreGui
            if not pcall(function() gui.Parent = parentGui end) then gui.Parent = pg end
            -- "hide game GUI" must not take this one away
            pcall(function()
                local hider = getgenv().GameGuiHider
                if hider and hider.Keep then hider.Keep(gui) end
            end)

            -- Roblox's own speed display belongs to the VehicleSeat: remember whether it was on (that is
            -- the game having a speedometer), and switch it off (this script runs only up to 2015 early)
            local hudSeat, hudWas = nil, nil
            if seat:IsA("VehicleSeat") then
                pcall(function()
                    local remembered = seat:GetAttribute("ClassicHudWas")
                    hudWas = (remembered ~= nil) and remembered or seat.HeadsUpDisplay
                    seat:SetAttribute("ClassicHudWas", hudWas)
                    seat.HeadsUpDisplay = false
                    hudSeat = seat
                end)
            end

            local shown = { gui = gui, bar = bar, label = label, seat = seat, clock = 0, nextCheck = 0, nextMeterScan = 0,
                            readout = nil, width = 0, shownNumber = nil, justShown = false,
                            hudSeat = hudSeat, hudWas = hudWas }
            shown.beat = RunService.RenderStepped:Connect(frame)
            display = shown
            print("[Speedometer] " .. (showOurs and "shown" or "(no speedometer in this era)") .. " for " .. seat:GetFullName() .. " (" .. seat.ClassName .. ")")
            frame(0)
        end

        local function onSeat(humanoid)
            local seat = humanoid.SeatPart
            if running and seat then show(seat) else hide() end
        end

        local function bindCharacter(character)
            task.spawn(function()
                local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
                if not running or not humanoid then return end
                table.insert(connections, humanoid:GetPropertyChangedSignal("SeatPart"):Connect(function()
                    onSeat(humanoid)
                end))
                onSeat(humanoid)
            end)
        end

        table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(character)
            hide()
            bindCharacter(character)
        end))
        if LocalPlayer.Character then bindCharacter(LocalPlayer.Character) end

        -- every half second: is the player in a seat? (in case an event was missed, or the character
        -- was replaced); this is two property reads
        task.spawn(function()
            while running do
                task.wait(0.5)
                if not running then break end
                if not vehicleHudHeld then pcall(switchOffVehicleHud) end   -- until it has been found
                local character = LocalPlayer.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                if humanoid then onSeat(humanoid) else hide() end
            end
        end)

        local function cleanup()
            running = false
            for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
            connections = {}
            hide()
            releaseGame()
            if getgenv().SpeedometerCleanup == cleanup then
                getgenv().SpeedometerCleanup = nil
                getgenv().SpeedometerMode = nil
            end
        end
        getgenv().SpeedometerCleanup = cleanup
        getgenv().SpeedometerMode = mode
        -- the game's speedometer GUIs that are already there, and Roblox's own vehicle speed display
        pcall(switchOffMeters)
        pcall(switchOffVehicleHud)
        print("[Loader] " .. (showOurs and "old speedometer on (2010-2014 / 2015 early, when the game has one)" or "no speedometer (2008 / 2006 / 2005)") .. ": the game's own speedometer is switched off")
    end

    local function stopSpeedometer()
        if getgenv().SpeedometerCleanup then pcall(getgenv().SpeedometerCleanup) end
    end

    --========================================================
    -- 2017 CHAT BUBBLES (2015 / 2016): your 2017 GUI script's own bubble chat, not a copy
    -- The bubble chat block ("LEGACY BUBBLE CHAT", Run(Settings.OldBubbleChat == true, ...)) is
    -- taken out of your 2017 GUI script as it is, and run. The loader draws nothing itself.
    -- The block only needs four things from the rest of that script (Players, TextChatService,
    -- TweenService, ExperienceChat); they are handed to it. It is wrapped in two small ways:
    --   * its chat hookup and its loop are noted, so they can be stopped if another topbar is
    --     picked (the block has no way to stop itself)
    --   * it is also given every message from Player.Chatted (the second chat event the 2011
    --     bubbles use), the same message from both events counted once, in case TextChatService
    --     isn't sending it one
    -- A few seconds after your first message the console says whether a bubble really showed. If
    -- none did, the block is stopped and Roblox's own bubbles come back (onBroken), so there is
    -- never nothing. Returns the function that stops it, or nil and the reason it couldn't start.
    --========================================================
    local function startBubbles2017(onBroken)
        if getgenv().Bubble2017Cleanup then pcall(getgenv().Bubble2017Cleanup) end

        local okGet, source = pcall(game.HttpGet, game, gui2017Url)
        if not okGet or type(source) ~= "string" or #source < 1000 then
            return nil, "couldn't download your 2017 GUI script"
        end
        local startAt = string.find(source, "Run(Settings.OldBubbleChat == true, function()", 1, true)
        local endAt = startAt and string.find(source, "\nend)", startAt, true)
        if not startAt or not endAt then
            return nil, "the bubble chat block wasn't found in your 2017 GUI script"
        end
        local block = string.sub(source, startAt, endAt + 4)

        -- what the block expects from the rest of the 2017 GUI script
        local prelude = [[
local Players, TextChatService, TweenService, ExperienceChat, task = ...
local Settings = { OldBubbleChat = true }
local Run = function(Bool, Callback)
	if Bool then
		task.spawn(Callback)
	end
end
]]
        local chunk, compileError = loadstring(prelude .. block)
        if not chunk then
            return nil, "the 2017 bubble chat didn't compile: " .. tostring(compileError)
        end

        local TweenService = game:GetService("TweenService")
        local chat = CoreGui:FindFirstChild("ExperienceChat") or CoreGui:WaitForChild("ExperienceChat", 3)
        local chatWasEnabled = nil
        pcall(function() chatWasEnabled = chat and chat.Enabled end)

        local alive = true
        local connections, threads = {}, {}
        local handler = nil              -- the block's own chat handler
        local recent = {}
        local shownOnce = false
        local checks = 0
        local checkLater

        -- one message into the block's handler (a message from both chat events counts once)
        local function deliver(userId, text, original)
            if not alive or not handler or not userId or type(text) ~= "string" or text == "" then return end
            local key = tostring(userId) .. ":" .. text
            if recent[key] then return end
            recent[key] = true
            task.delay(1.5, function() recent[key] = nil end)
            local ok, err = pcall(handler, original or { TextSource = { UserId = userId }, Text = text })
            if not ok then warn("[2017 bubbles] the bubble chat errored on a message: " .. tostring(err)) end
            if userId == Players.LocalPlayer.UserId then checkLater() end
        end

        -- the block connects to TextChatService.MessageReceived: its handler is kept, and fed here
        local messageSignal = TextChatService.MessageReceived
        local proxyChat = setmetatable({
            MessageReceived = {
                Connect = function(_, fn)
                    handler = fn
                    local connection = messageSignal:Connect(function(message)
                        local sender = message and message.TextSource
                        if sender then deliver(sender.UserId, message.Text, message) end
                    end)
                    table.insert(connections, connection)
                    return connection
                end,
            },
        }, { __index = function(_, key) return TextChatService[key] end })

        -- the block's threads (its loop) are noted, so they can be cancelled
        local proxyTask = setmetatable({
            spawn = function(fn, ...)
                local thread = task.spawn(fn, ...)
                table.insert(threads, thread)
                return thread
            end,
        }, { __index = task })

        local function cleanup()
            if not alive then return end
            alive = false
            for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
            connections = {}
            for _, thread in ipairs(threads) do pcall(task.cancel, thread) end
            threads = {}
            -- the bubbles already on screen
            for _, player in ipairs(Players:GetPlayers()) do
                local character = player.Character
                if character then
                    pcall(function()
                        for _, d in ipairs(character:GetDescendants()) do
                            if d:IsA("BillboardGui") and d.Name == "ChatBubbleGui" then d:Destroy() end
                        end
                    end)
                end
            end
            -- Roblox's chat display goes back the way it was
            if chat and chatWasEnabled ~= nil then pcall(function() chat.Enabled = chatWasEnabled end) end
            if getgenv().Bubble2017Cleanup == cleanup then getgenv().Bubble2017Cleanup = nil end
        end

        local ok, runError = pcall(chunk, Players, proxyChat, TweenService, chat, proxyTask)
        if not ok then
            cleanup()
            return nil, "the 2017 bubble chat errored: " .. tostring(runError)
        end
        -- the block starts on its own thread: give it a moment to hook up to chat
        local waited = 0
        while not handler and waited < 1 do
            task.wait(0.05)
            waited = waited + 0.05
        end
        if not handler then
            cleanup()
            return nil, "the 2017 bubble chat didn't connect to chat"
        end

        -- the second chat event
        local function hookPlayer(player)
            table.insert(connections, player.Chatted:Connect(function(text) deliver(player.UserId, text) end))
        end
        for _, player in ipairs(Players:GetPlayers()) do hookPlayer(player) end
        table.insert(connections, Players.PlayerAdded:Connect(hookPlayer))

        -- did your message really show a bubble? (judged a few seconds after it, up close, three times at most)
        local function check()
            if not alive or shownOnce then return end
            local character = Players.LocalPlayer.Character
            local head = character and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart"))
            if not head then return end
            local cam = Workspace.CurrentCamera
            if cam and (cam.CFrame.Position - head.Position).Magnitude > 40 then return end
            local made, shown = false, false
            for _, d in ipairs(character:GetDescendants()) do
                if d:IsA("BillboardGui") and d.Name == "ChatBubbleGui" then
                    made = true
                    local frame = d:FindFirstChild("BillboardFrame")
                    local bubble = frame and frame:FindFirstChild("ChatBubble")
                    if bubble and bubble.Visible and d.Enabled then shown = true break end
                end
            end
            if shown then
                shownOnce = true
                print("[2017 bubbles] your message drew a bubble")
                return
            end
            local reason = made and "a bubble was made but stayed hidden" or "no bubble was made"
            warn("[2017 bubbles] your message didn't show a bubble (" .. reason .. ")")
            if onBroken then task.spawn(onBroken, reason) end
        end
        checkLater = function()
            checks = checks + 1
            if checks > 3 then return end
            task.delay(4, check)
        end

        getgenv().Bubble2017Cleanup = cleanup
        print("[2017 bubbles] running (your 2017 GUI script's bubble chat)")
        return cleanup
    end

    --========================================================
    -- BUBBLE SCRIPTS (one per era)
    -- Loaded with retries; remembered only when they really started; the previous era's bubbles
    -- are stopped (through the cleanup function the script registered) before the next era's
    -- script starts, so two eras never run on top of each other.
    --========================================================
    local BUBBLE_SOURCES = {
        modern     = function() return { URL_BUBBLE_2015_2016 } end,
    }
    -- a downloaded script must contain its end marker (a cut-short download is tried again)
    local BUBBLE_MARKERS = {}
    local CLEANUP_WORDS = { "cleanup", "unload", "destroy", "stop", "disable" }

    local activeBubbleEra = nil     -- era whose bubble script is running right now
    local bubbleCleanups = {}       -- era -> functions that stop that script
    local cannotStop = {}           -- era -> true: it ran but registered no cleanup (stays running)
    local bubbleBusy = false
    local desiredBubbleEra = nil    -- the era the last Confirm asked for (nil = no GUI selected)
    local lastFailedEra = nil       -- an era whose download failed (tried again on the next Confirm)

    local function snapshotGenv()
        local copy = {}
        pcall(function() for k, v in pairs(getgenv()) do copy[k] = v end end)
        return copy
    end

    local function fetchBubbleSource(urls, marker)
        for _, url in ipairs(urls) do
            for attempt = 1, 2 do
                local ok, src = pcall(game.HttpGet, game, url)
                if ok and type(src) == "string" and #src > 20 and not src:find("^%s*<") and not src:find("^404")
                   and (not marker or src:find(marker, 1, true)) then
                    return src, url
                end
                task.wait(0.4)
            end
        end
        return nil
    end

    local function stopBubbleScript(era)
        if era == "bubble2017" and getgenv().Bubble2017Cleanup then
            pcall(getgenv().Bubble2017Cleanup)
        end
        for _, fn in ipairs(bubbleCleanups[era] or {}) do pcall(fn) end
        bubbleCleanups[era] = nil
        if activeBubbleEra == era then activeBubbleEra = nil end
        getgenv().BloxyBubbleEra = activeBubbleEra
    end

    local function startBubbleScript(era)
        if activeBubbleEra == era or bubbleBusy then return end
        bubbleBusy = true
        local failed = false
        local failReason = nil
        local startOk, startError = pcall(function()
            -- 2011-2014: the classic bubbles are built in (nothing to download)
            if era == "classic" then
                if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
                bubbleCleanups[era] = { startClassicBubbles() }
                activeBubbleEra = era
                getgenv().BloxyBubbleEra = era
                print("[Loader] classic bubbles started")
                return
            end

            -- 2015 / 2016: the bubble chat of your 2017 GUI script (the real one, not a copy)
            if era == "bubble2017" then
                if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
                local cleanup, why = startBubbles2017(function(reason)
                    -- your message didn't show a bubble: Roblox's own bubbles instead of none
                    warn("[Loader] 2015 / 2016: the 2017 bubble chat showed nothing (" .. tostring(reason) .. "), so Roblox's own bubbles are back")
                    if activeBubbleEra == "bubble2017" then stopBubbleScript("bubble2017") end
                    lastFailedEra = "bubble2017"
                    setNativeBubbles(false)
                end)
                if not cleanup then
                    failed = true
                    failReason = why
                    return
                end
                bubbleCleanups[era] = { cleanup }
                activeBubbleEra = era
                getgenv().BloxyBubbleEra = era
                return
            end

            -- a script that cannot be stopped is still running: do not start a second copy
            if cannotStop[era] then
                if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
                activeBubbleEra = era
                getgenv().BloxyBubbleEra = era
                return
            end

            local src, usedUrl = fetchBubbleSource(BUBBLE_SOURCES[era](), BUBBLE_MARKERS[era])
            if not src then
                failed = true
                failReason = "couldn't download them"
                warn("[Loader] could not download the " .. era .. " bubble script (will retry on the next Confirm)")
                return
            end
            -- the choice may have changed while it was downloading (another era, or none)
            if desiredBubbleEra ~= era then return end
            if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
            local chunk, compileError = loadstring(applySpeedups(src))
            if not chunk then
                failed = true
                failReason = "the script didn't compile: " .. tostring(compileError)
                warn("[Loader] the " .. era .. " bubble script did not compile:", compileError)
                return
            end

            -- The script runs on its own thread. Most return at once; one that keeps running in
            -- its main part (a loop) must not hold this loader up, so it is waited for 3 seconds.
            local before = snapshotGenv()
            local finished, runOk, runError = false, true, nil
            task.spawn(function()
                runOk, runError = pcall(chunk)
                finished = true
            end)
            local waited = 0
            while not finished and waited < 3 do
                task.wait(0.1)
                waited = waited + 0.1
            end
            if finished and not runOk then
                failed = true
                failReason = "the script errored: " .. tostring(runError)
                warn("[Loader] the " .. era .. " bubble script errored:", runError)
                return
            end

            -- any new global function named like a cleanup stops this script later
            local cleanups = {}
            pcall(function()
                for key, value in pairs(getgenv()) do
                    if before[key] ~= value and type(value) == "function" then
                        local lowered = string.lower(tostring(key))
                        for _, word in ipairs(CLEANUP_WORDS) do
                            if lowered:find(word, 1, true) then table.insert(cleanups, value) break end
                        end
                    end
                end
            end)
            bubbleCleanups[era] = cleanups
            cannotStop[era] = (#cleanups == 0) or nil
            activeBubbleEra = era
            getgenv().BloxyBubbleEra = era
            print("[Loader] " .. era .. " bubbles loaded from " .. tostring(usedUrl):sub(1, 90))
        end)
        bubbleBusy = false
        -- an unexpected error is a failure too (it used to make this start itself again and again)
        if not startOk then
            failed = true
            failReason = "loader error: " .. tostring(startError)
            warn("[Loader] starting the " .. era .. " bubbles failed:", startError)
        end
        if failed then
            -- not tried again until the next Confirm
            lastFailedEra = era
            -- A bubble script that did not start must not leave the game without any bubbles: the
            -- regular ones (switched off for the 2011-2014 bubbles) come back.
            setNativeBubbles(false)
        end
        if era == "bubble2017" and desiredBubbleEra == era then
            if failed then
                showNote("2015 / 2016: the 2017 chat bubbles didn't start (" .. tostring(failReason) .. "), so the regular ones stay", true)
            elseif activeBubbleEra == era then
                showNote("2015 / 2016: 2017 chat bubbles on")
            end
        end
        -- the last Confirm may have asked for another era while this one was loading
        if desiredBubbleEra and desiredBubbleEra ~= activeBubbleEra and lastFailedEra ~= desiredBubbleEra then
            task.spawn(startBubbleScript, desiredBubbleEra)
        end
    end

