--========================================================
-- THE 2012-2016 GUIS (Legacy, github.com/yeku/legacy) ON OUR OWN FOOTING
-- Bloxy's 2013, 2015 and 2016 GUIs are its settings plus loadstring(game:HttpGet(yeku's Source.luau)), and its 2014
-- GUI (a pastebin, also the base of the early 2015 GUI) has the same code built in. Each step of that can fail:
--   * yeku's Source.luau changing or going away: More guis.lua points that link at this repo's copy (Legacy Gui.lua,
--     the original code, with the fixes below)
--   * the RBXM Suite library not loading: getgenv().BP_Legacy.LoadSuite tries yeku's, then this repo's copy
--     (RBXM Suite.lua, MIT, by 0866)
--   * the Legacy model: "@latest" asks GitHub's API first, which allows only so many requests an hour; if that fails
--     it is taken straight from the release, and else from an earlier download (BP_Legacy.rbxm)
--   * waiting forever for the modern chat's bubbleChat (BP_Legacy.Bubbles waits 10 s, then goes on without the
--     old bubble look), and a phone without RobloxGui.NotificationFrame (that line threw, so the rest never ran)
-- The 2014 pastebin's built-in copy gets the same fixes as it is loaded (More guis.lua), and when pastebin doesn't
-- answer, this repo's copy of it (2014 Gui.lua) is used (BP_Legacy.Get2014).
--========================================================
do
    local env = getgenv()
    local SUITE_URLS = {
        "https://raw.githubusercontent.com/yeku/forks/refs/heads/main/Scripts/RBXMSuite.luau",
        "https://raw.githubusercontent.com/eloredo413-hue/Addtion-Scripts/main/RBXM%20Suite.lua",
    }
    local MODEL_RELEASE = "https://github.com/yeku/legacy/releases/latest/download/Legacy.rbxm"
    local MODEL_BACKUP = "BP_Legacy.rbxm"
    local SUITE_CACHE = "_rbxm-suite-v2/models/yeku-legacy-latest-Legacy_rbxm.rbxm"
    local function has(path)
        local ok, yes = pcall(function() return isfile and isfile(path) end)
        return ok and yes == true
    end
    local helpers = env.BP_Legacy or {}
    env.BP_Legacy = helpers
    local loadedSuite = nil
    function helpers.LoadSuite()
        if loadedSuite then return loadedSuite end
        local errors = {}
        for _, url in ipairs(SUITE_URLS) do
            local ok, result = pcall(function()
                local src
                local shared = env.BPDownload
                if type(shared) == "function" then
                    local good, body = shared(url)
                    if good then src = body end
                end
                if src == nil then src = game:HttpGet(url) end
                assert(type(src) == "string" and #src > 1000, "empty download")
                local fn = assert(loadstring(src, "RBXMSuite"))
                local suite = fn()
                assert(type(suite) == "table" and type(suite.launch) == "function", "not RBXM Suite")
                return suite
            end)
            if ok then
                loadedSuite = result
                if url ~= SUITE_URLS[1] then print("[Loader] Legacy: RBXM Suite from this repo's copy") end
                return result
            end
            table.insert(errors, tostring(result))
        end
        error("RBXM Suite couldn't be loaded (" .. table.concat(errors, "; ") .. ")", 0)
    end
    function helpers.Suite()
        return env.Suite or helpers.LoadSuite()
    end
    -- a model file is a real one only if it starts like one (a failed download leaves "Not Found" or a web page)
    local function isModelData(data)
        return type(data) == "string" and #data > 20000 and string.sub(data, 1, 7) == "<roblox"
    end
    local function isModelFile(path)
        local ok, data = pcall(function() return readfile(path) end)
        return ok and isModelData(data)
    end
    -- A model from a GitHub release ("user/repo@tag", asset), never a broken one: RBXM Suite keeps whatever it
    -- downloaded, a failed download too, and then uses that broken file every time. A broken file is deleted and the
    -- release is asked again; a good copy is kept as BP_<asset> for a day the download fails. Returns nil when there is
    -- no good copy anywhere.
    function helpers.Release(repository, asset)
        local user, repo, tag = string.match(repository, "([^/]+)/([^@]+)@?(.*)")
        local backup = "BP_" .. asset
        local suite = helpers.Suite()
        local ok, path = pcall(function() return suite.download(repository, asset) end)
        if ok and type(path) == "string" and isModelFile(path) then
            if not has(backup) then
                task.defer(function() pcall(function() writefile(backup, readfile(path)) end) end)
            end
            return path
        end
        if ok and type(path) == "string" and has(path) then
            warn("[Loader] " .. asset .. ": the saved download is broken, it is deleted and downloaded again")
            pcall(function() delfile(path) end)
        else
            warn("[Loader] " .. asset .. ": the usual download failed (" .. tostring(path) .. "), taking it from the release")
        end
        local url = (tag == "" or tag == "latest")
            and ("https://github.com/" .. user .. "/" .. repo .. "/releases/latest/download/" .. asset)
            or ("https://github.com/" .. user .. "/" .. repo .. "/releases/download/" .. tag .. "/" .. asset)
        local okGet, data = pcall(function() return game:HttpGet(url) end)
        if okGet and isModelData(data) and pcall(writefile, backup, data) and isModelFile(backup) then
            return backup
        end
        if isModelFile(backup) then
            warn("[Loader] " .. asset .. ": using the copy downloaded earlier (" .. backup .. ")")
            return backup
        end
        warn("[Loader] " .. asset .. ": not available (the release answered: " .. (okGet and string.sub(tostring(data), 1, 30) or tostring(data)) .. ")")
        return nil
    end
    function helpers.Model(suite)
        local path = helpers.Release("yeku/legacy@latest", "Legacy.rbxm")
        if path then return path end
        if isModelFile(SUITE_CACHE) then return SUITE_CACHE end
        error("the Legacy model couldn't be downloaded", 0)
    end
    -- Bloxy's 2014 GUI (also the early 2015 GUI's base) is on pastebin, which often blocks executors: this repo's copy
    -- (2014 Gui.lua) when pastebin doesn't answer
    local PASTEBIN_2014 = "https://pastebin.com/raw/h5AEhK7N"
    local REPO_2014 = "https://raw.githubusercontent.com/eloredo413-hue/Addtion-Scripts/main/2014%20Gui.lua"
    -- The 2014 GUI starts with Roblox's dark 2016 loading screen. Its BlackFrame (the whole screen) is never shown: the
    -- 2014 GUI and the early 2015 GUI get the 2014 one instead (Old Loading Screen.lua). Its ErrorFrame (a disconnect
    -- message) still works.
    function helpers.Without2016Loading(src)
        local _, b = string.find(src, "Name = 'BlackFrame',", 1, true)
        if not b then return src end
        return string.sub(src, 1, b) .. " Visible = false, -- (Addtion-Scripts: the 2014 loading screen shows instead)"
            .. string.sub(src, b + 1)
    end
    function helpers.Get2014()
        -- (this repo's copy first: pastebin often hangs instead of failing, and then the 2014 GUI never came, at random)
        for _, url in ipairs({ REPO_2014, PASTEBIN_2014 }) do
            for _ = 1, 2 do
                local ok, src = pcall(function() return game:HttpGet(url) end)
                if ok and type(src) == "string" and #src > 5000 and string.find(src, "LegacySettings", 1, true) then
                    if url == PASTEBIN_2014 then print("[Loader] 2014 GUI: this repo's copy didn't come, pastebin's is used") end
                    return helpers.Without2016Loading(src)
                end
                task.wait(0.5)
            end
        end
        error("the 2014 GUI couldn't be downloaded (pastebin and this repo's copy)", 0)
    end
    function helpers.Bubbles()
        local CoreGuiService = game:GetService("CoreGui")
        local chat = CoreGuiService:FindFirstChild("ExperienceChat") or CoreGuiService:WaitForChild("ExperienceChat", 10)
        local bubbles = chat and (chat:FindFirstChild("bubbleChat") or chat:WaitForChild("bubbleChat", 10))
        if bubbles then return bubbles end
        warn("[Loader] Legacy: the modern chat's bubbleChat wasn't found, the GUI loads without the old bubble look")
        return Instance.new("Folder") -- (an empty stand-in, so the rest of the GUI still loads)
    end
end

--========================================================
-- 2016 GUI: THE 2017 LEADERBOARD
-- Bloxy's 2016 GUI is Legacy running its 2016 core scripts. Its leaderboard is swapped for the 2017 one, which has
-- the right icons: when Legacy is launched for the 2016 pick, the 2017 GUI's model (Legacy2017.rbxm) is got ready
-- first, then the 2016 PlayerlistModule's code is replaced by the 2017 one (its own first line kept: that line ties a
-- module to the model it was launched with), with any module it asks for that the 2016 GUI doesn't have. All before
-- the 2016 scripts start. The same way the early 2015 GUI (E2015 Gui.lua) brings in the 2016 leaderboard. If anything
-- isn't there, the 2016 leaderboard stays, and the console says why.
--========================================================
do
    local env = getgenv()
    if not env.BP_Leaderboard2017Hook then
        env.BP_Leaderboard2017Hook = true
        local previous = env.Suite
        local real = nil
        local function base()
            if not real then real = previous or env.BP_Legacy.LoadSuite() end
            return real
        end
        local HEADER = "^local script, require = unpack%b(); "
        local function find(obj, ...)
            for _, name in ipairs({ ... }) do obj = obj and obj:FindFirstChild(name) end
            return obj
        end
        local function is2016()
            local pick = tostring(env.BloxyTopbarPick or env.BP_PendingTopbar or "")
            return string.match(pick, "^%s*2016%s*$") ~= nil
        end
        local function isLegacy(path)
            return type(path) == "string" and string.find(path, "Legacy", 1, true) ~= nil
                and not string.find(path, "2017", 1, true)
        end
        -- the modules a script asks for by name (WaitForChild("X"), FindFirstChild("X"), Modules.X)
        local function namesIn(source)
            local names = {}
            for name in string.gmatch(source, 'WaitForChild%(%s*["\']([%w_]+)["\']') do names[name] = true end
            for name in string.gmatch(source, 'FindFirstChild%(%s*["\']([%w_]+)["\']') do names[name] = true end
            for name in string.gmatch(source, 'Modules%.([%w_]+)') do names[name] = true end
            return names
        end
        -- the 2017 model, launched without running anything (its modules load only when asked for)
        local function prepare2017()
            local suite = base()
            local path2017 = env.BP_Legacy.Release("letsafe/something@v1.0.0", "Legacy2017.rbxm")
            if not path2017 then error("the 2017 model couldn't be downloaded", 0) end
            local model2017 = suite.launch(path2017, {
                runscripts = false, deferred = true, nocache = false, nocirculardeps = true, debug = true, verbose = false,
            })
            local modules2017 = find(model2017, "Core", "2017", "NewRobloxGui", "Modules")
            local list2017 = modules2017 and modules2017:FindFirstChild("PlayerlistModule")
            if not (list2017 and type(list2017.Source) == "string" and string.match(list2017.Source, HEADER)) then
                error("the 2017 PlayerlistModule wasn't found", 0)
            end
            return { modules = modules2017, list = list2017 }
        end
        -- (no waiting in here: the 2016 scripts start as soon as this thread waits)
        local function swapLeaderboard(legacy, pieces)
            local modules2016 = find(legacy, "Core", "2016", "NewRobloxGui", "Modules")
            local list2016 = modules2016 and modules2016:FindFirstChild("PlayerlistModule")
            local header2016 = list2016 and string.match(list2016.Source, HEADER)
            local header2017 = string.match(pieces.list.Source, HEADER)
            if not (header2016 and header2017) then
                warn("[Loader] 2016 leaderboard: the 2016 PlayerlistModule wasn't found as expected, the 2016 one stays")
                return
            end
            -- what the 2017 leaderboard asks for and the 2016 GUI doesn't have: brought over (nothing is replaced)
            local brought = {}
            local body = string.sub(pieces.list.Source, #header2017 + 1)
            for name in pairs(namesIn(body)) do
                if modules2016:FindFirstChild(name, true) == nil then
                    local piece = pieces.modules:FindFirstChild(name, true)
                    if piece then
                        local chain, holder = {}, piece.Parent
                        while holder and holder ~= pieces.modules do
                            table.insert(chain, 1, holder.Name)
                            holder = holder.Parent
                        end
                        local parent = modules2016
                        for _, folderName in ipairs(chain) do
                            local folder = parent:FindFirstChild(folderName)
                            if not folder then
                                folder = Instance.new("Folder")
                                folder.Name = folderName
                                folder.Parent = parent
                            end
                            parent = folder
                        end
                        piece.Parent = parent
                        table.insert(brought, name)
                    end
                end
            end
            list2016.Source = header2016 .. body
            print("[Loader] 2016 GUI: the 2017 leaderboard is in" .. (#brought > 0 and (" (with " .. table.concat(brought, ", ") .. ")") or ""))
        end
        env.Suite = setmetatable({
            launch = function(path, options)
                local pieces = nil
                if is2016() and isLegacy(path) then
                    local ok, result = pcall(prepare2017)
                    if ok then pieces = result else warn("[Loader] 2016 leaderboard: " .. tostring(result) .. " (the 2016 one stays)") end
                end
                local results = table.pack(base().launch(path, options))
                if pieces then
                    local ok, err = pcall(swapLeaderboard, results[1], pieces)
                    if not ok then warn("[Loader] 2016 leaderboard: " .. tostring(err) .. " (the 2016 one stays)") end
                end
                return table.unpack(results, 1, results.n)
            end,
        }, { __index = function(_, key)
            -- (Addtion-Scripts) Not downloaded here: downloading waits, and a metamethod cannot wait ("thread is not yieldable"):
            -- the 2019 menu's Suite.download(...) came through here before the library was loaded and failed with it, and
            -- the 2021 GUI showed the red "2019 ESC menu ERROR while starting: RBXM Suite couldn't be loaded" message. What
            -- is asked for gets loaded when it is CALLED, which can wait.
            if real ~= nil then return real[key] end
            if previous ~= nil and previous[key] ~= nil then return previous[key] end
            return function(...)
                local member = base()[key]
                if type(member) == "function" then return member(...) end
                return member
            end
        end })
    end
end

--========================================================
-- KEEP ROBLOX'S NPC DIALOG BOX
-- Roblox's NPC dialog builds its choice box ("Goodbye!" etc.) and its message box inside
-- CoreGui.RobloxGui. The 2014 base (2014 / 2015 early), 2015 and 2016 GUIs delete ControlFrame
-- (which holds them), and the 2017 / 2019 GUIs switch RobloxGui off, so the box was gone or
-- hidden: nothing to pick, and on phones the controls (Roblox hides them while you choose)
-- never came back. Only those two pieces (DialogFrame and DialogScriptMessage) are moved, here,
-- before any of those GUIs load, into a GUI of their own that stays on, above the hotbar. They
-- keep their place on screen (empty frames copy the position and size of what held them), and
-- Roblox's dialog script keeps working as normal. ControlFrame itself is left where Roblox
-- expects it (the 2017 / 2019 GUIs say to never remove it on a touch device).
--========================================================
local function keepDialogBox()
    local hui = nil
    pcall(function() hui = gethui and gethui() end)
    -- kept already (this script was run before in this server)
    for _, container in ipairs({ CoreGui, hui }) do
        local kept = container and container:FindFirstChild("DialogBoxHost")
        if kept and kept:FindFirstChild("DialogFrame", true) then
            return true
        end
    end

    local robloxGui = CoreGui:FindFirstChild("RobloxGui")
    if not robloxGui then return false end
    local pieces = {}
    for _, name in ipairs({ "DialogFrame", "DialogScriptMessage" }) do
        local piece = robloxGui:FindFirstChild(name, true)
        if piece and piece:IsA("GuiObject") then table.insert(pieces, piece) end
    end
    if #pieces == 0 then return false end

    local host = Instance.new("ScreenGui")
    host.Name = "DialogBoxHost"
    host.ResetOnSpawn = false
    host.DisplayOrder = 1000 -- above the topbar GUIs' hotbars
    pcall(function() host.IgnoreGuiInset = robloxGui.IgnoreGuiInset end)
    pcall(function() host.ScreenInsets = robloxGui.ScreenInsets end)
    if not pcall(function() host.Parent = CoreGui end) then
        host.Parent = hui or Players.LocalPlayer:WaitForChild("PlayerGui")
    end

    local moved = 0
    for _, piece in ipairs(pieces) do
        -- empty frames with the position and size of what held the piece, so it stays in place
        local chain = {}
        local holder = piece.Parent
        while holder and holder ~= robloxGui do
            table.insert(chain, 1, holder)
            holder = holder.Parent
        end
        local parent = host
        for _, ancestor in ipairs(chain) do
            local frame = Instance.new("Frame")
            frame.Name = ancestor.Name
            frame.BackgroundTransparency = 1
            frame.BorderSizePixel = 0
            if ancestor:IsA("GuiObject") then
                frame.AnchorPoint = ancestor.AnchorPoint
                frame.Position = ancestor.Position
                frame.Size = ancestor.Size
            else
                frame.Size = UDim2.new(1, 0, 1, 0)
            end
            frame.Parent = parent
            parent = frame
        end
        if pcall(function() piece.Parent = parent end) then moved = moved + 1 end
    end
    if moved == 0 then
        host:Destroy()
        return false
    end
    return true
end

