            end)
        end
    end

    -- (Hammer stuff 2 calls this when "old healthbar" is ticked or unticked)
    getgenv().BPRefreshHealthBar = function()
        pcall(updateOldHealthBar)
        pcall(updateNotifications)
        -- a 2013 loading screen still showing (the saved "old healthbar" was put back just after it started): the
        -- other 2013 one in its place
        pcall(function()
            local env = getgenv()
            local api = env.OldLoadingScreen
