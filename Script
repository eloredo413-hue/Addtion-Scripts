task.spawn(function()
    local player = Players.LocalPlayer
    local pg = player:WaitForChild("PlayerGui")

    local dialogLoaded_Classic = false

    -- Text of a saved choice: a string, or (if the config stores a table) its string values.
    local function choiceText(value)
        if type(value) == "string" then return value end
        if type(value) == "table" then
            local parts = {}
            for _, v in pairs(value) do
                if type(v) == "string" then table.insert(parts, v) end
            end
            return table.concat(parts, " ")
        end
        return nil
    end

    -- classic    = 2010-2014 / mobile
    -- bubble2017 = 2015 / 2016 (they use the 2017 bubbles)
    -- modern     = 2017-2020
    -- none       = anything else (no GUI selected): nothing is touched
    -- 2015 / 2016 win when the text names one of them (a label such as "2016 (2014 style)" is
    -- 2016); the classic years and "mobile" only decide when no 2015 / 2016 is named.
    local function classifyEra(text)
        local s = string.lower(text or "")
        if s:find("2015", 1, true) or s:find("2016", 1, true) then return "bubble2017" end
        if s:find("2010", 1, true) or s:find("2011", 1, true) or s:find("2012", 1, true)
           or s:find("2013", 1, true) or s:find("2014", 1, true) or s:find("mobile", 1, true) then
            return "classic"
        end
        if s:find("2017", 1, true) or s:find("2018", 1, true) or s:find("2019", 1, true) or s:find("2020", 1, true) then
            return "modern"
        end
        return "none"
    end

    local function getSelectedEra()
        local actual = "none"
        pcall(function()
            if readfile and isfile and isfile("BloxyParadoxConfig.json") then
                local cfg = HttpService:JSONDecode(readfile("BloxyParadoxConfig.json"))
                actual = (cfg.Choices and cfg.Choices.Topbar) or cfg.Topbar or cfg.topbar or cfg.TopbarChoice or cfg.TopbarID or "none"
            end
        end)

        local text = choiceText(actual)
        if not text then return "none", tostring(actual) end
        return classifyEra(text), text
    end

    local TextChatService = game:GetService("TextChatService")
    local nativeBubblesHidden = false
    local hiddenNativeBubbles = {}
    local savedBubbleEnabled = nil

    local function sweepNativeBubbles()
        pcall(function()
            for _, obj in ipairs(CoreGui:GetDescendants()) do
                if obj:IsA("BillboardGui") and obj.Enabled
                   and not obj:GetAttribute("ClassicOwned")
                   and string.find(string.lower(obj.Name), "bubble", 1, true) then
                    obj.Enabled = false
                    hiddenNativeBubbles[obj] = true
                end
            end
        end)
    end

    local function setNativeBubbles(hide)
        if hide then
            nativeBubblesHidden = true
            pcall(function()
                local cfg = TextChatService:FindFirstChildOfClass("BubbleChatConfiguration")
                if cfg then
                    if savedBubbleEnabled == nil then savedBubbleEnabled = cfg.Enabled end
                    cfg.Enabled = false
                end
            end)
            sweepNativeBubbles()
        elseif nativeBubblesHidden then
            nativeBubblesHidden = false
            pcall(function()
                local cfg = TextChatService:FindFirstChildOfClass("BubbleChatConfiguration")
                if cfg and savedBubbleEnabled ~= nil then cfg.Enabled = savedBubbleEnabled end
                savedBubbleEnabled = nil
            end)
            for obj in pairs(hiddenNativeBubbles) do
                pcall(function() obj.Enabled = true end)
            end
            hiddenNativeBubbles = {}
        end
    end

    -- status for the console only (no message on screen)
    local function showNote(text, isProblem)
        if isProblem then
            warn("[Loader] " .. text)
        else
            print("[Loader] " .. text)
        end
    end

    --========================================================
    -- CLASSIC CHAT BUBBLES (2010-2014 / mobile)
    -- White bubbles over players' heads, built into this loader. A new message goes at the
    -- bottom with the tail; the player's older messages stay stacked above it with grey text.
    -- No fading: bubbles appear and disappear at once, like 2011.
    --========================================================
    local function startClassicBubbles()
        if getgenv().ClassicBubbleCleanup then pcall(getgenv().ClassicBubbleCleanup) end

        local Chat = game:GetService("Chat")

        local BUBBLE_NAME = "__CLASSIC_2011_BUBBLE"
        local MAX_DISTANCE = 75
        local DOT_DISTANCE = 52          -- farther than this: the newest bubble shows "..."
        local LIFETIME = 20              -- seconds a message stays up
        local MAX_BUBBLES = 3            -- messages shown at once per player
        local BUBBLE_GAP = 2
        local FONT_SIZE = 20
        local MAX_WIDTH = 220
        local TAIL_WIDTH, TAIL_HEIGHT = 16, 19
        local DOTS_WIDTH, DOTS_HEIGHT = 52, 38
        local TEXT_COLOR = Color3.fromRGB(0, 0, 0)
        local OLD_TEXT_COLOR = Color3.fromRGB(160, 160, 160)

        local running = true
        local connections = {}
        local stacks = {}                -- player -> { gui, head, tail, entries, far, connection }
        local lastMessages = {}

        -- the old (legacy) bubble chat is switched off while these bubbles run
        local savedLegacyBubbles = nil
        pcall(function()
            savedLegacyBubbles = Chat.BubbleChatEnabled
            Chat:SetBubbleChatEnabled(false)
        end)

        -- a player's character (not an NPC, so NPC dialog icons are never touched)
        local function playerCharacterOf(object)
            local current = object
            while current and current ~= game do
                if current:IsA("Model") and Players:GetPlayerFromCharacter(current) then return current end
                current = current.Parent
            end
            return nil
        end

        local function isForeignBubble(object)
            return (object:IsA("BillboardGui") or object:IsA("SurfaceGui"))
                and object.Name ~= BUBBLE_NAME
                and not object:GetAttribute("ClassicOwned")
        end

        local function belongsToPlayerCharacter(object)
            if object.Adornee and playerCharacterOf(object.Adornee) then return true end
            return playerCharacterOf(object) ~= nil
        end

        -- other bubble guis on a player's character (the game's own chat bubbles)
        local function removeCharacterBubbles(character)
            if not character then return end
            for _, object in ipairs(character:GetDescendants()) do
                if isForeignBubble(object) then pcall(function() object:Destroy() end) end
            end
        end

        -- places the bubbles from the bottom up; the newest one sits on the tail
        local function layout(stack)
            local entries = stack.entries
            local count = #entries
            if count == 0 then return end

            if stack.far then
                for i, entry in ipairs(entries) do
                    local newest = i == count
                    entry.frame.Visible = newest
                    if newest then
                        entry.label.Text = "..."
                        entry.label.Size = UDim2.new(1, -16, 0, 20)
                        entry.label.Position = UDim2.new(0, 8, 0, 9)
                        entry.frame.Size = UDim2.new(0, DOTS_WIDTH, 0, DOTS_HEIGHT)
                        entry.frame.Position = UDim2.new(0.5, -DOTS_WIDTH / 2, 0, 0)
                    end
                end
                stack.gui.Size = UDim2.new(0, DOTS_WIDTH, 0, DOTS_HEIGHT + TAIL_HEIGHT)
                stack.tail.Position = UDim2.new(0.5, -TAIL_WIDTH / 2, 0, DOTS_HEIGHT - 6)
                return
            end

            local width, total = 0, 0
            for i, entry in ipairs(entries) do
                width = math.max(width, entry.width)
                total = total + entry.height
                if i > 1 then total = total + BUBBLE_GAP end
            end
            stack.gui.Size = UDim2.new(0, width, 0, total + TAIL_HEIGHT)

            local y = total
            for i = count, 1, -1 do
                local entry = entries[i]
                y = y - entry.height
                entry.frame.Visible = true
                entry.frame.Size = UDim2.new(0, entry.width, 0, entry.height)
                entry.frame.Position = UDim2.new(0.5, -entry.width / 2, 0, y)
                entry.label.Text = entry.text
                entry.label.Size = UDim2.new(1, -16, 0, entry.textHeight)
                entry.label.Position = UDim2.new(0, 8, 0, 12)
                y = y - BUBBLE_GAP
            end
            stack.tail.Position = UDim2.new(0.5, -TAIL_WIDTH / 2, 0, total - 6)
        end

        local function destroyStack(player)
            local stack = stacks[player]
            if not stack then return end
            stacks[player] = nil
            if stack.connection then stack.connection:Disconnect() end
            pcall(function() stack.gui:Destroy() end)
        end

        local function removeEntry(stack, entry)
            if entry.removed then return end
            entry.removed = true
            local index = table.find(stack.entries, entry)
            if index then table.remove(stack.entries, index) end
            pcall(function() entry.frame:Destroy() end)
            if stacks[stack.player] ~= stack then return end
            if #stack.entries == 0 then
                destroyStack(stack.player)
            else
                layout(stack)
            end
        end

        local function getStack(player, head)
            local existing = stacks[player]
            if existing and existing.head == head and existing.gui.Parent then return existing end
            destroyStack(player)

            for _, object in ipairs(head:GetChildren()) do
                if object.Name == BUBBLE_NAME then object:Destroy() end
            end

            local gui = Instance.new("BillboardGui")
            gui.Name = BUBBLE_NAME
            gui.Adornee = head
            gui.Size = UDim2.new(0, DOTS_WIDTH, 0, DOTS_HEIGHT + TAIL_HEIGHT)
            gui.StudsOffset = Vector3.new(0, 2.5, 0)
            gui.SizeOffset = Vector2.new(0, 0.5)
            gui.MaxDistance = MAX_DISTANCE
            gui.AlwaysOnTop = false
            gui.ZIndexBehavior = Enum.ZIndexBehavior.Global

            local tail = Instance.new("ImageLabel")
            tail.Name = "Tail"
            tail.BackgroundTransparency = 1
            tail.Image = "rbxassetid://2582470060"
            tail.Size = UDim2.new(0, TAIL_WIDTH, 0, TAIL_HEIGHT)
            tail.ZIndex = 4
            tail.Parent = gui

            local connector = Instance.new("Frame")
            connector.Name = "Connector"
            connector.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            connector.BorderSizePixel = 0
            connector.Size = UDim2.new(0, 10, 0, 6)
            connector.Position = UDim2.new(0.5, -5, 0, -4)
            connector.ZIndex = 3
            connector.Parent = tail

            local stack = { player = player, gui = gui, head = head, tail = tail, entries = {}, far = false }

            stack.connection = RunService.RenderStepped:Connect(function()
                if not gui.Parent then
                    if stacks[player] == stack then destroyStack(player) else stack.connection:Disconnect() end
                    return
                end
                local cam = Workspace.CurrentCamera
                if not cam then return end
                local far = (cam.CFrame.Position - head.Position).Magnitude > DOT_DISTANCE
                if far ~= stack.far then
                    stack.far = far
                    layout(stack)
                end
            end)

            stacks[player] = stack
            gui.Parent = head
            return stack
        end

        local function createBubble(player, text)
            local character = player.Character
            local head = character and character:FindFirstChild("Head")
            if not head then return end
            removeCharacterBubbles(character)

            local stack = getStack(player, head)

            -- older messages stay above, with grey text
            for _, old in ipairs(stack.entries) do
                old.label.TextColor3 = OLD_TEXT_COLOR
            end
            -- too many: the oldest goes
            while #stack.entries >= MAX_BUBBLES do
                removeEntry(stack, stack.entries[1])
            end

            local measured = TextService:GetTextSize(text, FONT_SIZE, Enum.Font.Arial, Vector2.new(MAX_WIDTH, 1000))

            local frame = Instance.new("Frame")
            frame.Name = "Bubble"
            frame.BackgroundTransparency = 1

            local body = Instance.new("ImageLabel")
            body.Name = "Body"
            body.BackgroundTransparency = 1
            body.Image = "rbxassetid://2582470061"
            body.ScaleType = Enum.ScaleType.Slice
            body.SliceCenter = Rect.new(29, 29, 67, 67)
            body.SliceScale = 0.4
            body.Size = UDim2.new(1, 0, 1, 0)
            body.ZIndex = 2
            body.Parent = frame

            local label = Instance.new("TextLabel")
            label.Name = "Text"
            label.BackgroundTransparency = 1
            label.FontFace = Font.new("rbxasset://fonts/families/Arial.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
            label.TextSize = FONT_SIZE
            label.TextColor3 = TEXT_COLOR
            label.TextWrapped = true
            label.Text = text
            label.ZIndex = 10
            label.Parent = frame

            local entry = {
                text = text,
                width = math.clamp(measured.X + 24, 42, MAX_WIDTH + 24),
                height = measured.Y + 24,
                textHeight = measured.Y,
                frame = frame,
                label = label,
            }
            table.insert(stack.entries, entry)
            frame.Parent = stack.gui
            layout(stack)

            task.delay(LIFETIME, function() removeEntry(stack, entry) end)
        end

        local function receiveMessage(player, text)
            if not running or not player then return end
            if typeof(text) ~= "string" or text == "" then return end
            -- the same message can arrive through both chat systems
            local key = tostring(player.UserId) .. ":" .. text
            if lastMessages[key] then return end
            lastMessages[key] = true
            task.delay(0.25, function() lastMessages[key] = nil end)
            createBubble(player, text)
        end

        local function hookPlayer(player)
            table.insert(connections, player.Chatted:Connect(function(text)
                receiveMessage(player, text)
            end))
            table.insert(connections, player.CharacterAdded:Connect(function(character)
                task.wait(0.2)
                if running then removeCharacterBubbles(character) end
            end))
        end
        for _, player in ipairs(Players:GetPlayers()) do hookPlayer(player) end
        table.insert(connections, Players.PlayerAdded:Connect(hookPlayer))
        table.insert(connections, Players.PlayerRemoving:Connect(destroyStack))

        pcall(function()
            table.insert(connections, TextChatService.MessageReceived:Connect(function(message)
                if not message or not message.TextSource then return end
                receiveMessage(Players:GetPlayerByUserId(message.TextSource.UserId), message.Text)
            end))
        end)

        -- the game's own bubbles on player characters are removed as soon as they appear
        local function watchContainer(container)
            table.insert(connections, container.DescendantAdded:Connect(function(object)
                if not isForeignBubble(object) then return end
                task.defer(function()
                    if running and object.Parent and belongsToPlayerCharacter(object) then
                        pcall(function() object:Destroy() end)
                    end
                end)
            end))
        end
        watchContainer(Workspace)
        watchContainer(pg)

        task.spawn(function()
            while running do
                for _, player in ipairs(Players:GetPlayers()) do
                    removeCharacterBubbles(player.Character)
                end
                pcall(function()
                    for _, object in ipairs(pg:GetDescendants()) do
                        if isForeignBubble(object) and belongsToPlayerCharacter(object) then object:Destroy() end
                    end
                end)
                task.wait(0.15)
            end
        end)

        local function cleanup()
            running = false
            for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
            connections = {}
            for player in pairs(stacks) do destroyStack(player) end
            if savedLegacyBubbles ~= nil then
                pcall(function() Chat:SetBubbleChatEnabled(savedLegacyBubbles) end)
            end
            if getgenv().ClassicBubbleCleanup == cleanup then getgenv().ClassicBubbleCleanup = nil end
        end
        getgenv().ClassicBubbleCleanup = cleanup
        return cleanup
    end

    --========================================================
    -- 2017 CHAT BUBBLES (2015 / 2016): your 2017 GUI script's own bubble chat, not a copy
    -- The bubble chat block ("LEGACY BUBBLE CHAT", Run(Settings.OldBubbleChat == true, ...)) is
    -- taken out of your 2017 GUI script as it is, and run. The loader draws nothing itself.
    -- The block only needs four things from the rest of that script (Players, TextChatService,
    -- TweenService, ExperienceChat); they are handed to it. It is wrapped in two small ways:
    --   * its chat hookup and its loop are noted, so they can be stopped if another topbar is
    --     picked (the block has no way to stop itself)
    --   * it is also given every message from Player.Chatted (the second chat event the 2011
    --     bubbles use), the same message from both events counted once, in case TextChatService
    --     isn't sending it one
    -- A few seconds after your first message the console says whether a bubble really showed. If
    -- none did, the block is stopped and Roblox's own bubbles come back (onBroken), so there is
    -- never nothing. Returns the function that stops it, or nil and the reason it couldn't start.
    --========================================================
    local function startBubbles2017(onBroken)
        if getgenv().Bubble2017Cleanup then pcall(getgenv().Bubble2017Cleanup) end

        local okGet, source = pcall(game.HttpGet, game, gui2017Url)
        if not okGet or type(source) ~= "string" or #source < 1000 then
            return nil, "couldn't download your 2017 GUI script"
        end
        local startAt = string.find(source, "Run(Settings.OldBubbleChat == true, function()", 1, true)
        local endAt = startAt and string.find(source, "\nend)", startAt, true)
        if not startAt or not endAt then
            return nil, "the bubble chat block wasn't found in your 2017 GUI script"
        end
        local block = string.sub(source, startAt, endAt + 4)

        -- what the block expects from the rest of the 2017 GUI script
        local prelude = [[
local Players, TextChatService, TweenService, ExperienceChat, task = ...
local Settings = { OldBubbleChat = true }
local Run = function(Bool, Callback)
	if Bool then
		task.spawn(Callback)
	end
end
]]
        local chunk, compileError = loadstring(prelude .. block)
        if not chunk then
            return nil, "the 2017 bubble chat didn't compile: " .. tostring(compileError)
        end

        local TweenService = game:GetService("TweenService")
        local chat = CoreGui:FindFirstChild("ExperienceChat") or CoreGui:WaitForChild("ExperienceChat", 3)
        local chatWasEnabled = nil
        pcall(function() chatWasEnabled = chat and chat.Enabled end)

        local alive = true
        local connections, threads = {}, {}
        local handler = nil              -- the block's own chat handler
        local recent = {}
        local shownOnce = false
        local checks = 0
        local checkLater

        -- one message into the block's handler (a message from both chat events counts once)
        local function deliver(userId, text, original)
            if not alive or not handler or not userId or type(text) ~= "string" or text == "" then return end
            local key = tostring(userId) .. ":" .. text
            if recent[key] then return end
            recent[key] = true
            task.delay(1.5, function() recent[key] = nil end)
            local ok, err = pcall(handler, original or { TextSource = { UserId = userId }, Text = text })
            if not ok then warn("[2017 bubbles] the bubble chat errored on a message: " .. tostring(err)) end
            if userId == Players.LocalPlayer.UserId then checkLater() end
        end

        -- the block connects to TextChatService.MessageReceived: its handler is kept, and fed here
        local messageSignal = TextChatService.MessageReceived
        local proxyChat = setmetatable({
            MessageReceived = {
                Connect = function(_, fn)
                    handler = fn
                    local connection = messageSignal:Connect(function(message)
                        local sender = message and message.TextSource
                        if sender then deliver(sender.UserId, message.Text, message) end
                    end)
                    table.insert(connections, connection)
                    return connection
                end,
            },
        }, { __index = function(_, key) return TextChatService[key] end })

        -- the block's threads (its loop) are noted, so they can be cancelled
        local proxyTask = setmetatable({
            spawn = function(fn, ...)
                local thread = task.spawn(fn, ...)
                table.insert(threads, thread)
                return thread
            end,
        }, { __index = task })

        local function cleanup()
            if not alive then return end
            alive = false
            for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
            connections = {}
            for _, thread in ipairs(threads) do pcall(task.cancel, thread) end
            threads = {}
            -- the bubbles already on screen
            for _, player in ipairs(Players:GetPlayers()) do
                local character = player.Character
                if character then
                    pcall(function()
                        for _, d in ipairs(character:GetDescendants()) do
                            if d:IsA("BillboardGui") and d.Name == "ChatBubbleGui" then d:Destroy() end
                        end
                    end)
                end
            end
            -- Roblox's chat display goes back the way it was
            if chat and chatWasEnabled ~= nil then pcall(function() chat.Enabled = chatWasEnabled end) end
            if getgenv().Bubble2017Cleanup == cleanup then getgenv().Bubble2017Cleanup = nil end
        end

        local ok, runError = pcall(chunk, Players, proxyChat, TweenService, chat, proxyTask)
        if not ok then
            cleanup()
            return nil, "the 2017 bubble chat errored: " .. tostring(runError)
        end
        -- the block starts on its own thread: give it a moment to hook up to chat
        local waited = 0
        while not handler and waited < 1 do
            task.wait(0.05)
            waited = waited + 0.05
        end
        if not handler then
            cleanup()
            return nil, "the 2017 bubble chat didn't connect to chat"
        end

        -- the second chat event
        local function hookPlayer(player)
            table.insert(connections, player.Chatted:Connect(function(text) deliver(player.UserId, text) end))
        end
        for _, player in ipairs(Players:GetPlayers()) do hookPlayer(player) end
        table.insert(connections, Players.PlayerAdded:Connect(hookPlayer))

        -- did your message really show a bubble? (judged a few seconds after it, up close, three times at most)
        local function check()
            if not alive or shownOnce then return end
            local character = Players.LocalPlayer.Character
            local head = character and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart"))
            if not head then return end
            local cam = Workspace.CurrentCamera
            if cam and (cam.CFrame.Position - head.Position).Magnitude > 40 then return end
            local made, shown = false, false
            for _, d in ipairs(character:GetDescendants()) do
                if d:IsA("BillboardGui") and d.Name == "ChatBubbleGui" then
                    made = true
                    local frame = d:FindFirstChild("BillboardFrame")
                    local bubble = frame and frame:FindFirstChild("ChatBubble")
                    if bubble and bubble.Visible and d.Enabled then shown = true break end
                end
            end
            if shown then
                shownOnce = true
                print("[2017 bubbles] your message drew a bubble")
                return
            end
            local reason = made and "a bubble was made but stayed hidden" or "no bubble was made"
            warn("[2017 bubbles] your message didn't show a bubble (" .. reason .. ")")
            if onBroken then task.spawn(onBroken, reason) end
        end
        checkLater = function()
            checks = checks + 1
            if checks > 3 then return end
            task.delay(4, check)
        end

        getgenv().Bubble2017Cleanup = cleanup
        print("[2017 bubbles] running (your 2017 GUI script's bubble chat)")
        return cleanup
    end

    --========================================================
    -- BUBBLE SCRIPTS (one per era)
    -- Loaded with retries; remembered only when they really started; the previous era's bubbles
    -- are stopped (through the cleanup function the script registered) before the next era's
    -- script starts, so two eras never run on top of each other.
    --========================================================
    local BUBBLE_SOURCES = {
        modern     = function() return { URL_BUBBLE_2015_2016 } end,
    }
    -- a downloaded script must contain its end marker (a cut-short download is tried again)
    local BUBBLE_MARKERS = {}
    local CLEANUP_WORDS = { "cleanup", "unload", "destroy", "stop", "disable" }

    local activeBubbleEra = nil     -- era whose bubble script is running right now
    local bubbleCleanups = {}       -- era -> functions that stop that script
    local cannotStop = {}           -- era -> true: it ran but registered no cleanup (stays running)
    local bubbleBusy = false
    local desiredBubbleEra = nil    -- the era the last Confirm asked for (nil = no GUI selected)
    local lastFailedEra = nil       -- an era whose download failed (tried again on the next Confirm)

    local function snapshotGenv()
        local copy = {}
        pcall(function() for k, v in pairs(getgenv()) do copy[k] = v end end)
        return copy
    end

    local function fetchBubbleSource(urls, marker)
        for _, url in ipairs(urls) do
            for attempt = 1, 2 do
                local ok, src = pcall(game.HttpGet, game, url)
                if ok and type(src) == "string" and #src > 20 and not src:find("^%s*<") and not src:find("^404")
                   and (not marker or src:find(marker, 1, true)) then
                    return src, url
                end
                task.wait(0.4)
            end
        end
        return nil
    end

    local function stopBubbleScript(era)
        if era == "bubble2017" and getgenv().Bubble2017Cleanup then
            pcall(getgenv().Bubble2017Cleanup)
        end
        for _, fn in ipairs(bubbleCleanups[era] or {}) do pcall(fn) end
        bubbleCleanups[era] = nil
        if activeBubbleEra == era then activeBubbleEra = nil end
        getgenv().BloxyBubbleEra = activeBubbleEra
    end

    local function startBubbleScript(era)
        if activeBubbleEra == era or bubbleBusy then return end
        bubbleBusy = true
        local failed = false
        local failReason = nil
        local startOk, startError = pcall(function()
            -- 2010-2014: the classic bubbles are built in (nothing to download)
            if era == "classic" then
                if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
                bubbleCleanups[era] = { startClassicBubbles() }
                activeBubbleEra = era
                getgenv().BloxyBubbleEra = era
                print("[Loader] classic bubbles started")
                return
            end

            -- 2015 / 2016: the bubble chat of your 2017 GUI script (the real one, not a copy)
            if era == "bubble2017" then
                if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
                local cleanup, why = startBubbles2017(function(reason)
                    -- your message didn't show a bubble: Roblox's own bubbles instead of none
                    warn("[Loader] 2015 / 2016: the 2017 bubble chat showed nothing (" .. tostring(reason) .. "), so Roblox's own bubbles are back")
                    if activeBubbleEra == "bubble2017" then stopBubbleScript("bubble2017") end
                    lastFailedEra = "bubble2017"
                    setNativeBubbles(false)
                end)
                if not cleanup then
                    failed = true
                    failReason = why
                    return
                end
                bubbleCleanups[era] = { cleanup }
                activeBubbleEra = era
                getgenv().BloxyBubbleEra = era
                return
            end

            -- a script that cannot be stopped is still running: do not start a second copy
            if cannotStop[era] then
                if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
                activeBubbleEra = era
                getgenv().BloxyBubbleEra = era
                return
            end

            local src, usedUrl = fetchBubbleSource(BUBBLE_SOURCES[era](), BUBBLE_MARKERS[era])
            if not src then
                failed = true
                failReason = "couldn't download them"
                warn("[Loader] could not download the " .. era .. " bubble script (will retry on the next Confirm)")
                return
            end
            -- the choice may have changed while it was downloading (another era, or none)
            if desiredBubbleEra ~= era then return end
            if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
            local chunk, compileError = loadstring(src)
            if not chunk then
                failed = true
                failReason = "the script didn't compile: " .. tostring(compileError)
                warn("[Loader] the " .. era .. " bubble script did not compile:", compileError)
                return
            end

            -- The script runs on its own thread. Most return at once; one that keeps running in
            -- its main part (a loop) must not hold this loader up, so it is waited for 3 seconds.
            local before = snapshotGenv()
            local finished, runOk, runError = false, true, nil
            task.spawn(function()
                runOk, runError = pcall(chunk)
                finished = true
            end)
            local waited = 0
            while not finished and waited < 3 do
                task.wait(0.1)
                waited = waited + 0.1
            end
            if finished and not runOk then
                failed = true
                failReason = "the script errored: " .. tostring(runError)
                warn("[Loader] the " .. era .. " bubble script errored:", runError)
                return
            end

            -- any new global function named like a cleanup stops this script later
            local cleanups = {}
            pcall(function()
                for key, value in pairs(getgenv()) do
                    if before[key] ~= value and type(value) == "function" then
                        local lowered = string.lower(tostring(key))
                        for _, word in ipairs(CLEANUP_WORDS) do
                            if lowered:find(word, 1, true) then table.insert(cleanups, value) break end
                        end
                    end
                end
            end)
            bubbleCleanups[era] = cleanups
            cannotStop[era] = (#cleanups == 0) or nil
            activeBubbleEra = era
            getgenv().BloxyBubbleEra = era
            print("[Loader] " .. era .. " bubbles loaded from " .. tostring(usedUrl):sub(1, 90))
        end)
        bubbleBusy = false
        -- an unexpected error is a failure too (it used to make this start itself again and again)
        if not startOk then
            failed = true
            failReason = "loader error: " .. tostring(startError)
            warn("[Loader] starting the " .. era .. " bubbles failed:", startError)
        end
        if failed then
            -- not tried again until the next Confirm
            lastFailedEra = era
            -- A bubble script that did not start must not leave the game without any bubbles: the
            -- regular ones (switched off for the 2010-2014 bubbles) come back.
            setNativeBubbles(false)
        end
        if era == "bubble2017" and desiredBubbleEra == era then
            if failed then
                showNote("2015 / 2016: the 2017 chat bubbles didn't start (" .. tostring(failReason) .. "), so the regular ones stay", true)
            elseif activeBubbleEra == era then
                showNote("2015 / 2016: 2017 chat bubbles on")
            end
        end
        -- the last Confirm may have asked for another era while this one was loading
        if desiredBubbleEra and desiredBubbleEra ~= activeBubbleEra and lastFailedEra ~= desiredBubbleEra then
            task.spawn(startBubbleScript, desiredBubbleEra)
        end
    end

