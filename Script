local function DisableModernBubbles()
	local Configuration = GetBubbleConfiguration()

	if not Configuration then
		return
	end

	pcall(function()
		if SavedBubbleEnabled == nil then
			SavedBubbleEnabled = Configuration.Enabled
		end

		if Configuration.Enabled then
			Configuration.Enabled = false
		end
	end)
end

DisableModernBubbles()

do
	local Watched = false

	local function WatchConfiguration(Configuration)
		if Watched or not Configuration then
			return
		end

		Watched = true

		DisableModernBubbles()

		table.insert(Connections, Configuration:GetPropertyChangedSignal("Enabled"):Connect(function()
			if Running and Configuration.Enabled then
				pcall(function()
					Configuration.Enabled = false
				end)
			end
		end))
	end

	WatchConfiguration(GetBubbleConfiguration())

	-- the configuration can be created after this script starts
	table.insert(Connections, TextChatService.ChildAdded:Connect(function(Child)
		if Running and Child:IsA("BubbleChatConfiguration") then
			WatchConfiguration(Child)
		end
	end))
end

-- Switching the configuration off is not enough on current Roblox: the modern bubbles are drawn
-- by CoreGui.ExperienceChat. So, like the 2017 and 2021 GUIs and the 2015 / 2016 chat bubble fix,
-- all of ExperienceChat is kept switched off while this runs (the 2015 / 2016 GUI has its own chat
-- window and hides the modern one anyway), and its bubble billboards too, in case it comes back on.
local HiddenModernBubbles = {}

local function HideModernBubble(Object)
	if not Running or HiddenModernBubbles[Object] ~= nil then
		return
	end

	local Success, IsLayer = pcall(function()
		return Object:IsA("LayerCollector")
	end)

	if not Success or not IsLayer then
		return
	end

	HiddenModernBubbles[Object] = Object.Enabled

	pcall(function()
		Object.Enabled = false
	end)

	table.insert(Connections, Object:GetPropertyChangedSignal("Enabled"):Connect(function()
		if Running and Object.Enabled then
			pcall(function()
				Object.Enabled = false
			end)
		end
	end))
end

task.spawn(function()
	-- ExperienceChat may not be built yet: look for it for a while
	for _ = 1, 60 do
		if not Running then
			return
		end

		local ExperienceChat = game:GetService("CoreGui"):FindFirstChild("ExperienceChat")
		local ModernBubbles = ExperienceChat and ExperienceChat:FindFirstChild("bubbleChat")

		if ExperienceChat then
			HideModernBubble(ExperienceChat)
		end

		if ModernBubbles then
			HideModernBubble(ModernBubbles)

			for _, Object in ipairs(ModernBubbles:GetDescendants()) do
				HideModernBubble(Object)
			end

			table.insert(Connections, ModernBubbles.DescendantAdded:Connect(HideModernBubble))

			return
		end

		task.wait(0.5)
	end
end)

--========================================================
-- MESSAGES
--========================================================

local function GetMessageLength(Message)
	local Success, Length = pcall(function()
		return utf8.len(utf8.nfcnormalize(Message))
	end)

	if Success and Length then
		return Length
	end

	return #Message
end

local function SanitizeChatLine(Message)
	local Length = GetMessageLength(Message)

	if Length <= MAX_CHAT_MESSAGE_LENGTH_EXCLUSIVE then
		return Message
	end

	local ByteOffset

	pcall(function()
		ByteOffset = utf8.offset(Message, MAX_CHAT_MESSAGE_LENGTH_EXCLUSIVE + GetMessageLength(ELLIPSES) + 1)
	end)

	if not ByteOffset then
		return string.sub(Message, 1, MAX_CHAT_MESSAGE_LENGTH_EXCLUSIVE)
	end

	return string.sub(Message, 1, ByteOffset - 1)
end

local function LerpLength(Message, Minimum, Maximum)
	local Alpha = math.min(GetMessageLength(Message) / 75, 1)

	return Minimum + (Maximum - Minimum) * Alpha
end

