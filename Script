--========================================================
-- KEEP ROBLOX'S NPC DIALOG BOX
-- Roblox's NPC dialog builds its choice box ("Goodbye!" etc.) and its message box inside
-- CoreGui.RobloxGui. The 2014 base (2014 / 2015 early), 2015 and 2016 GUIs delete ControlFrame
-- (which holds them), and the 2017 / 2019 GUIs switch RobloxGui off, so the box was gone or
-- hidden: nothing to pick, and on phones the controls (Roblox hides them while you choose)
-- never came back. Only those two pieces (DialogFrame and DialogScriptMessage) are moved, here,
-- before any of those GUIs load, into a GUI of their own that stays on, above the hotbar. They
-- keep their place on screen (empty frames copy the position and size of what held them), and
-- Roblox's dialog script keeps working as normal. ControlFrame itself is left where Roblox
-- expects it (the 2017 / 2019 GUIs say to never remove it on a touch device).
--========================================================
local function keepDialogBox()
    local hui = nil
    pcall(function() hui = gethui and gethui() end)
    -- kept already (this script was run before in this server)
    for _, container in ipairs({ CoreGui, hui }) do
        local kept = container and container:FindFirstChild("DialogBoxHost")
        if kept and kept:FindFirstChild("DialogFrame", true) then
            return true
        end
    end

    local robloxGui = CoreGui:FindFirstChild("RobloxGui")
    if not robloxGui then return false end
    local pieces = {}
    for _, name in ipairs({ "DialogFrame", "DialogScriptMessage" }) do
        local piece = robloxGui:FindFirstChild(name, true)
        if piece and piece:IsA("GuiObject") then table.insert(pieces, piece) end
    end
    if #pieces == 0 then return false end

    local host = Instance.new("ScreenGui")
    host.Name = "DialogBoxHost"
    host.ResetOnSpawn = false
    host.DisplayOrder = 1000 -- above the topbar GUIs' hotbars
    pcall(function() host.IgnoreGuiInset = robloxGui.IgnoreGuiInset end)
    pcall(function() host.ScreenInsets = robloxGui.ScreenInsets end)
    if not pcall(function() host.Parent = CoreGui end) then
        host.Parent = hui or Players.LocalPlayer:WaitForChild("PlayerGui")
    end

    local moved = 0
    for _, piece in ipairs(pieces) do
        -- empty frames with the position and size of what held the piece, so it stays in place
        local chain = {}
        local holder = piece.Parent
        while holder and holder ~= robloxGui do
            table.insert(chain, 1, holder)
            holder = holder.Parent
        end
        local parent = host
        for _, ancestor in ipairs(chain) do
            local frame = Instance.new("Frame")
            frame.Name = ancestor.Name
            frame.BackgroundTransparency = 1
            frame.BorderSizePixel = 0
            if ancestor:IsA("GuiObject") then
                frame.AnchorPoint = ancestor.AnchorPoint
                frame.Position = ancestor.Position
                frame.Size = ancestor.Size
            else
                frame.Size = UDim2.new(1, 0, 1, 0)
            end
            frame.Parent = parent
            parent = frame
        end
        if pcall(function() piece.Parent = parent end) then moved = moved + 1 end
    end
    if moved == 0 then
        host:Destroy()
        return false
    end
    return true
end

