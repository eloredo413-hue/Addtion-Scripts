    --========================================================
    -- CLASSIC NOTIFICATIONS (Classic Notifications.lua in this repo): badges and friend requests, by GUI
    --   2014: the 2013-2014 boxes with the 2014 NotificationScript's words ("2014": "Badge Awarded!" and its icon...)
    --   2011, 2012, 2013 / 2013 mobile: the 2013-2014 boxes ("classic")
    --   before 2011: no boxes, a badge plays victory.wav ("sound")
    --   2015 and later (and no GUI): Roblox's own notices
    -- In the first three, Roblox's own badge notice is hidden (and its friend request notice, when nothing is shown).
    --========================================================
    local URL_NOTIFICATIONS = "https://raw.githubusercontent.com/eloredo413-hue/Addtion-Scripts/main/Classic%20Notifications.lua?v=" .. tostring(os.time())
    local notificationsLoading = false
    local updateNotifications
    updateNotifications = function()
        local env = getgenv()
        local pick = tostring(env.BloxyTopbarPick or env.BloxyTopbarRaw or "")
        local year = tonumber(string.match(pick, "(20%d%d)"))
        local oldBar = env.BPOldHealthBar2013 == true or env.BPOldHealthBar2013Mobile == true
        local mode = nil
        if year == 2014 then
            mode = "2014" -- (the 2013-2014 boxes with the 2014 NotificationScript's words and icons)
        elseif year == 2011 or year == 2012 or year == 2013 then
            -- (the old boxes for 2011, 2012 and 2013 too, as the user asked: they were silent there before)
            mode = "classic"
        elseif year and year < 2011 then
            mode = "sound"
        end
        local api = env.ClassicNotifications
        print("[Loader] notifications: " .. tostring(year) .. " GUI -> " .. (mode or "Roblox's own"))
        if mode then
            env.ClassicNotificationsMode = mode
            if type(api) == "table" and type(api.Start) == "function" then pcall(api.Start, mode) return end
            if notificationsLoading then return end
            notificationsLoading = true
            task.spawn(function()
                local _, why = loadUrl(URL_NOTIFICATIONS, "Classic Notifications")
                notificationsLoading = false
                if why == "download" then
                    warn("[Loader] Classic Notifications.lua couldn't be downloaded")
                    return
                end
                pcall(updateNotifications) -- (the GUI may have changed while it downloaded)
            end)
        elseif type(api) == "table" and type(api.Stop) == "function" then
            pcall(api.Stop)
        end
    end
    --========================================================
    -- OLD LOADING SCREENS (Old Loading Screen.lua): the loading screen each GUI starts with, drawn above the GUI
    --   2006: none of ours: the 2006 GUI shows its own "Loading Character..." screen, as it always had
    --   2011, 2012, and 2013 / 2013 mobile with the old health bar ON: the same in a black box ("2011")
    --   2013 / 2013 mobile with the old health bar OFF: "Powered By ROBLOX" ("2013", about 7 s)
    --   2014 and 2015 early: the 2014 one ("2014"; the 2014 GUI's own dark 2016 one never shows, see Get2014)
    --   2015, 2016: the 2016 one ("2016")
    -- (2008 has its own in 2008 Gui.lua; 2005, 2010 and 2017 on have none of ours)
    --========================================================
    local function loadingStyleFor(era, year, fromFlags)
        if era == "early2015" then return "2014" end
        if era == "y2006" then return nil end -- (the 2006 GUI's own loading screen)
        if era == "y2010" or era == "y2005" or era == "none" then return nil end
        if year == 2011 or year == 2012 then return "2011" end
        if year == 2013 then
            local env = getgenv()
            -- (Addtion-Scripts) The old health bar is turned on or off a moment AFTER the loading screen goes up when a preset (or
            -- a saved file) sets it, so the first screen was the wrong one and the other took its place: two loading screens
            -- one after the other. The setting is already in the config file by then, so that is what counts. The flags the
            -- hammer sets stay set in the executor between runs (early 2014 after 2013 showed regular 2013's older screen from
            -- the old flag): they are only used when the config doesn't say.
            -- (fromFlags: the hammer has just ticked or unticked the old health bar and set the flags, but has not saved the config
            -- yet: the file still holds the OLD answer, which swapped the right loading screen for the other one a moment after
            -- it went up: regular 2013 (old health bar on) showed its black box, then Powered By over it)
            local cfg = (not fromFlags) and readJsonFile("BloxyParadoxConfig.json") or nil
            local oldBar
            if cfg ~= nil and cfg.isOldHealthBarEnabled ~= nil then
                oldBar = cfg.isOldHealthBarEnabled == true
            else
                oldBar = env.BPOldHealthBar2013 == true or env.BPOldHealthBar2013Mobile == true
            end
            return oldBar and "2011" or "2013"
        end
        -- (the 2015 GUI shows the 2016 loading screen, as the user asked in the 2015 recording: its own grey one is not used)
        if year == 2015 then return "2016" end
        if year == 2014 or year == 2016 then return tostring(year) end
        return nil
    end
    local loadingScreenKey = nil
    local function showLoadingScreen(style)
        local env = getgenv()
        env.BPLoadingScreenYear = style
        if type(env.OldLoadingScreen) == "table" and type(env.OldLoadingScreen.Show) == "function" then
