    local legacyDisconnectOn = false
    local oldPurchaseLoading = false
    local function evaluateAndLoad()
        local era, raw = getSelectedEra()
        if confirmedVariant then
            era, raw = confirmedVariant, confirmedVariantName
        else
            -- (Addtion-Scripts) No Confirm seen for this GUI (a preset, or a saved file, answering the setup, or the
            -- setup's < >): the GUI that was picked (BloxyTopbarPick, which Saved Settings sets when it presses the
            -- list), not the year Bloxy's config holds. That one can be an older year left over from before (or the
            -- year a More guis GUI stands in for), which gave 2008, 2006 and the like the 2014 loading screen, the
            -- 2014 purchase prompt and the classic bubbles.
            local known = tostring(getgenv().BloxyTopbarPick or "")
            if known ~= "" then
                local variant = TOPBAR_VARIANTS[known] or TOPBAR_VARIANTS[string.lower(known)]
                if variant then
                    era, raw = variant, known
                else
                    era, raw = classifyEra(known), known
                end
            end
        end
        print("[Loader] topbar choice \"" .. tostring(raw) .. "\" -> era: " .. era)
        getgenv().BloxyEra = era
        getgenv().BloxyTopbarRaw = tostring(raw)

        -- LEGACY DISCONNECT MESSAGE: with the (later) 2015 / 2016 / 2017 GUIs a disconnect shows as the
        -- old red bar under the top bar (Legacy Disconnect.lua), no box or blur. The real pick is used (More guis'
        -- 2017 / 2019 save as "2023").
        do
            local pick = tostring(getgenv().BloxyTopbarPick or raw or "")
            local year = tonumber(string.match(pick, "20%d%d") or "")
            -- (only the later 2015 GUI, 2016 and 2017: not early 2015, not 2019, nor any year before or after, as the
            -- user asked)
            local early = string.find(string.lower(pick), "early", 1, true) ~= nil
            if year and year >= 2015 and year <= 2017 and not early then
                if not legacyDisconnectOn then
                    legacyDisconnectOn = true
                    task.spawn(function()
                        local ok, why = loadUrl(URL_LEGACY_DISCONNECT, "Legacy Disconnect")
                        if not ok then
                            legacyDisconnectOn = false
                            warn("[Loader] the legacy disconnect message didn't start: " .. tostring(why))
                        end
                    end)
                end
            elseif legacyDisconnectOn then
                legacyDisconnectOn = false
                local stop = getgenv().LegacyDisconnectStop
                if type(stop) == "function" then pcall(stop) end
            end
            -- OLD LOADING SCREENS: each GUI starts with its own loading screen, drawn above it (see loadingStyleFor).
            -- Once for each GUI picked.
            local loadingStyle = loadingStyleFor(era, year)
            if loadingStyle then
                local key = pick .. "|" .. tostring(era)
                if loadingScreenKey ~= key then
                    loadingScreenKey = key
                    print("[Loader] loading screen: " .. pick .. " GUI -> " .. loadingStyle)
                    showLoadingScreen(loadingStyle)
                end
            else
                loadingScreenKey = nil
            end
            -- EARLY 2015: A STRAY GREY BOX in the bottom right corner (the user's screenshot of it: about 105 x 60 pixels, light
            -- grey (160, 163, 170) with a dark edge, half off the screen, just under the jump button). Nothing of ours draws
            -- that, so it is looked for by what it looks like (a grey box touching the corner) a few times while everything
            -- has loaded, hidden, and named in the console so the culprit can be found.
            if year == 2015 and early and not getgenv().BPStrayBoxWatch then
                getgenv().BPStrayBoxWatch = true
                task.spawn(function()
                    local Players = game:GetService("Players")
                    local gone = setmetatable({}, { __mode = "k" })
                    local function isGrey(c)
                        return math.abs(c.R * 255 - 160) < 12 and math.abs(c.G * 255 - 163) < 12 and math.abs(c.B * 255 - 170) < 12
                    end
                    local function scan()
                        local camera = workspace.CurrentCamera
                        if not camera then return end
                        local view = camera.ViewportSize
                        local roots = {}
                        local player = Players.LocalPlayer
                        if player and player:FindFirstChildOfClass("PlayerGui") then table.insert(roots, player:FindFirstChildOfClass("PlayerGui")) end
                        pcall(function() table.insert(roots, game:GetService("CoreGui")) end)
                        local seen = 0
                        for _, root in ipairs(roots) do
                            for _, d in ipairs(root:GetDescendants()) do
                                seen = seen + 1
                                if seen % 400 == 0 then task.wait() end
                                if d:IsA("GuiObject") and d.Visible and not gone[d] and d.BackgroundTransparency < 0.5 and isGrey(d.BackgroundColor3) then
                                    local pos, size = d.AbsolutePosition, d.AbsoluteSize
                                    if size.X > 0 and size.X <= view.X * 0.15 and size.Y <= view.Y * 0.25
                                        and pos.X >= view.X * 0.85 and pos.Y >= view.Y * 0.85
                                        and pos.X + size.X >= view.X * 0.97 and pos.Y + size.Y >= view.Y * 0.9 then
                                        gone[d] = true
                                        pcall(function() d.Visible = false end)
                                        pcall(function()
                                            d:GetPropertyChangedSignal("Visible"):Connect(function()
                                                if d.Visible and gone[d] then d.Visible = false end
                                            end)
                                        end)
                                        print("[Loader] early 2015: a stray grey box in the bottom right corner hidden: " .. d:GetFullName())
                                    end
                                end
                            end
                        end
                    end
                    local last = 0
                    for _, at in ipairs({ 5, 10, 18, 30, 60 }) do
                        task.wait(at - last)
                        last = at
                        pcall(scan)
                    end
                    getgenv().BPStrayBoxWatch = nil
                end)
            end
            -- OLD PURCHASE PROMPT: the 2013 - 2019 GUIs (the 2013 / 2014 GUIs and 2015 - 2019) get the 2016 purchase
            -- prompt in place of Roblox's modern one (Roblox's own comes back if it cannot run, see Old Purchase Prompt.lua)
            local promptApi = getgenv().OldPurchasePrompt
            if year and year >= 2013 and year <= 2019 then
                -- (the 2014 GUI: the 2014 prompt, Roblox's own 2014 script; the others the 2016 one)
                local promptStyle = (year == 2014) and "2014" or "2016"
                getgenv().OldPurchasePromptStyle = promptStyle
                print("[Loader] old purchase prompt: " .. year .. " GUI -> on (" .. promptStyle .. ")")
                if promptApi then
                    if type(promptApi.Style) == "function" and promptApi.Style() ~= promptStyle and promptApi.Running() then
                        pcall(promptApi.Stop)
                    end
                    pcall(promptApi.Start)
                elseif not oldPurchaseLoading then
                    oldPurchaseLoading = true
                    task.spawn(function()
                        local _, why = loadUrl(URL_OLD_PURCHASE, "Old Purchase Prompt")
                        oldPurchaseLoading = false
                        if why == "download" then warn("[Loader] Old Purchase Prompt.lua couldn't be downloaded") end
                    end)
                end
            elseif promptApi then
                pcall(promptApi.Stop)
            end
        end
        pcall(updateOldHealthBar)
        pcall(updateNotifications)
        -- the bubble script each era runs (none for "none", 2015 early, 2010, 2006 and 2005)
        local bubbleEra = era
        if era == "none" or era == "early2015" or era == "y2010" or era == "y2006" or era == "y2005" then
            bubbleEra = nil
        end
        desiredBubbleEra = bubbleEra
        if bubbleEra and lastFailedEra == bubbleEra then lastFailedEra = nil end
        -- the classic bubbles stopped by something else (the 2011 GUI clears them when it starts, so a
        -- leftover copy from another GUI goes): marked stopped, so they are started again below
        if activeBubbleEra == "classic" and not getgenv().ClassicBubbleCleanup then
            stopBubbleScript("classic")
        end

        if era ~= "bubble2017" then
            -- leaving 2015 / 2016: the 2017 bubbles stop
            if activeBubbleEra == "bubble2017" then stopBubbleScript("bubble2017") end
            if getgenv().Bubble2017Cleanup then pcall(getgenv().Bubble2017Cleanup) end
        end

        -- The game's own (modern) speedometer only shows from 2015 on. Up to 2015 early it is switched off:
        -- 2010-2014 and 2015 early get the old speedometer (the blue bar) in its place, 2005 / 2006 have none.
        -- 2013 (regular and mobile): its backpack takes touch and mouse (the 2013 GUI's own one loses tools you drag)
        if era == "classic" and tostring(raw) == "2013" and not backpack2013Loaded then
            backpack2013Loaded = true
            task.spawn(function()
                local _, why = loadUrl(URL_BACKPACK_2013, "2013 Backpack")
                if why == "download" then
                    backpack2013Loaded = false
                    warn("[Loader] 2013 Backpack couldn't be downloaded")
                end
            end)
        end

        -- (the 2008 GUI of More guis is a "y2010" for the bubbles, but older than 2010: no speedometer)
        local is2008 = tostring(raw) == "2008"
        if not (is2008 and era == "y2010") then stopDialogBubbleHider() end
        if (era == "classic" or era == "y2010" or era == "early2015") and not is2008 then
            local ok, err = pcall(startSpeedometer, "show")
            if not ok then warn("[Loader] the speedometer didn't start: " .. tostring(err)) end
        elseif era == "y2006" or era == "y2005" or is2008 then
            local ok, err = pcall(startSpeedometer, "hideOnly")
            if not ok then warn("[Loader] the speedometer hider didn't start: " .. tostring(err)) end
        else
            stopSpeedometer()
        end

        setDialogBoxShown(not (era == "classic" or (era == "y2010" and not is2008)))

        if era == "none" then
            if getgenv().ClassicDialogCleanup then pcall(getgenv().ClassicDialogCleanup) end
            dialogLoaded_Classic = false
            setNativeBubbles(false)
            if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
            -- nothing selected: the 2017 bubbles must not stay on
            if getgenv().Bubble2017Cleanup then pcall(getgenv().Bubble2017Cleanup) end
            return
        end

        if era == "classic" then
            setNativeBubbles(true)
            task.spawn(startBubbleScript, "classic")
            if not dialogLoaded_Classic then
                dialogLoaded_Classic = true
                task.spawn(injectClassicDialogs)
            end

        elseif era == "bubble2017" then
            -- 2015 / 2016: the 2017 bubbles, with Roblox's own bubbles hidden the same way the
            -- classic bubbles hide them. If the 2017 bubbles can't start, the regular ones come back.
            setNativeBubbles(true)
            if getgenv().ClassicDialogCleanup then pcall(getgenv().ClassicDialogCleanup) end
            dialogLoaded_Classic = false
            task.spawn(startBubbleScript, "bubble2017")

        elseif era == "early2015" then
            -- 2015 early draws its own early 2015 chat bubbles, so no bubble script of ours runs
            -- (the classic one removed its bubbles, any other would add a second set), and
            -- Roblox's own bubbles stay off as for 2014. Dialogs are Roblox's default ones (their
            -- choice box is kept at the top of this script).
            setNativeBubbles(true)
            if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
            if getgenv().Bubble2017Cleanup then pcall(getgenv().Bubble2017Cleanup) end
            if getgenv().ClassicDialogCleanup then pcall(getgenv().ClassicDialogCleanup) end
            dialogLoaded_Classic = false

        elseif era == "y2010" and is2008 then
            -- 2008: like 2010 (its GUI draws no bubbles of ours, Roblox's own stay off), but no
            -- dialog bubbles over NPCs: the classic dialogs do not run, and the ones Roblox draws
            -- are switched off.
            setNativeBubbles(true)
            if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
            if getgenv().Bubble2017Cleanup then pcall(getgenv().Bubble2017Cleanup) end
            if getgenv().ClassicDialogCleanup then pcall(getgenv().ClassicDialogCleanup) end
            dialogLoaded_Classic = false
            startDialogBubbleHider()

        elseif era == "y2010" then
            -- 2010 draws its own chat bubbles (Retro2009ChatBubbles, in PlayerGui). The 2011-style
            -- bubble engine must not run: it removes every other bubble from the characters, which
            -- took the 2010 GUI's own away and drew ours instead. Roblox's own bubbles stay off
            -- (the 2010 GUI turns them off too). The classic dialogs stay as they were.
            setNativeBubbles(true)
            if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
            if getgenv().Bubble2017Cleanup then pcall(getgenv().Bubble2017Cleanup) end
            if not dialogLoaded_Classic then
                dialogLoaded_Classic = true
                task.spawn(injectClassicDialogs)
            end

        elseif era == "y2006" or era == "y2005" then
            -- 2006 and 2005: no chat bubbles, no NPC dialogs back then. Their GUIs hide Roblox's own
            -- dialog and chat bubbles (2006 saves as "2013" in Bloxy, which used to start the 2011
            -- bubbles over it), so neither the classic dialogs nor a bubble script of ours run.
            setNativeBubbles(true)
            if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
            if getgenv().Bubble2017Cleanup then pcall(getgenv().Bubble2017Cleanup) end
            if getgenv().ClassicDialogCleanup then pcall(getgenv().ClassicDialogCleanup) end
            dialogLoaded_Classic = false

        elseif era == "modern" then
            setNativeBubbles(false)
            if getgenv().ClassicDialogCleanup then pcall(getgenv().ClassicDialogCleanup) end
            dialogLoaded_Classic = false
            task.spawn(startBubbleScript, "modern")
        end
    end

    -- Confirm: the era is read from the saved config. The config may be written a moment after
    -- the click, so it is read again a little later (the second reading changes nothing when the
    -- era is the same; it only fixes a reading that was taken before the config was saved).
    local function onConfirm(confirmBtn)
        -- read at the click: Bloxy removes the topbar question right after
        local listText = topbarListText(confirmBtn)
        if listText then
            local name = cleanListText(listText)
            confirmedVariant = TOPBAR_VARIANTS[name]
            confirmedVariantName = confirmedVariant and name or nil
        elseif confirmBtn:FindFirstAncestor("BloxyParadoxProject") then
            -- Bloxy's Confirm, but its list couldn't be read
            local pending = getgenv().BP_PendingTopbar
            confirmedVariant = pending and PENDING_VARIANTS[pending] or nil
            confirmedVariantName = confirmedVariant and pending or nil
        else
            return -- some other script's "confirm" button: not the topbar
        end
        -- The real pick, for the escape menu: More guis' 2017 / 2019 / 2021 / 2024 press Bloxy's
        -- "2023", so the saved config says 2023 for all of them.
        do
            local pick = (listText and cleanListText(listText)) or getgenv().BP_PendingTopbar
            getgenv().BloxyTopbarPick = pick and tostring(pick) or nil
            -- kept for "skip setup" (see THE TOPBAR PICKED IN MORE GUIS at the top)
            if pick and writefile then
                pcall(function()
                    writefile(TOPBAR_PICK_FILE, HttpService:JSONEncode({ Pick = tostring(pick) }))
                end)
            end
        end
        confirmSeen = true
        -- the GUI's follow-up (bubbles, dialogs, loading screen, escape menu ...). With the setup's < > on, the GUI
        -- itself only loads after the last question, so this waits for it too (the last Confirm's wins).
        local function followUp()
            if getgenv().BPMenuRecheck then
                for _, delay in ipairs({ 0.3, 1.5, 4 }) do task.delay(delay, getgenv().BPMenuRecheck) end
            end
            -- (8 s: a GUI that takes a while to download, like 2011, has started by then. Right now too: the loading
            -- screen is the first thing up when everything has been picked, before the GUI loads under it)
            task.spawn(evaluateAndLoad)
            for _, delay in ipairs({ 0.5, 2, 4, 8 }) do
                task.delay(delay, evaluateAndLoad)
            end
        end
        local wizard = getgenv().BPWizard
        if not (type(wizard) == "table" and type(wizard.later) == "function" and wizard.later("loader: the GUI's follow-up", followUp)) then
            followUp()
        end
    end

    -- Confirm buttons are hooked when they appear (or when a button in Bloxy's GUI is renamed
    -- "Confirm"). This used to look through all of PlayerGui four times a second, for as long as
    -- the game ran, which got slower the more GUI the game had.
    local function hookConfirm(obj)
        if obj:GetAttribute("BPHookedConfirm") then return end
        if not string.find(string.lower(obj.Text or ""), "confirm", 1, true) then return end
        obj:SetAttribute("BPHookedConfirm", true)
        obj.MouseButton1Click:Connect(function() onConfirm(obj) end)
    end

    local function watchButton(obj)
        -- looked at a moment later: the script that made it may still be setting its name and text
        task.defer(function()
            if not obj.Parent then return end
            hookConfirm(obj)
            if not obj:GetAttribute("BPHookedConfirm") and obj:FindFirstAncestor("BloxyParadoxProject") then
                obj:GetPropertyChangedSignal("Text"):Connect(function() hookConfirm(obj) end)
            end
        end)
    end

    if pg then
        for _, obj in ipairs(pg:GetDescendants()) do
            if obj.ClassName == "TextButton" then watchButton(obj) end
        end
        pg.DescendantAdded:Connect(function(obj)
            if obj.ClassName == "TextButton" then watchButton(obj) end
        end)
    end

    -- Bloxy can load the saved topbar without a Confirm click: with "skip setup" ticked it does
    -- so as it starts, and the topbar may also have been confirmed before this script was run.
    -- Then the bubbles and dialogs never followed it. Now, once Bloxy's GUI is up and its topbar
    -- question isn't on screen, the saved choice is followed too. (Picks that More guis adds
    -- can't be told apart there: Bloxy saved the year they press, and that is what it loaded.)
    local function topbarQuestionShown(sg)
        for _, d in ipairs(sg:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text == "Which topbar do you prefer?" then return true end
        end
        return false
    end

    task.spawn(function()
        local sg = pg:WaitForChild("BloxyParadoxProject", 300)
        if not sg then return end
        task.wait(3)
        if confirmSeen or topbarQuestionShown(sg) then return end
        -- (Addtion-Scripts) THE SETUP IS STILL BEING ANSWERED (a preset answers it by itself, quicker than the topbar question
        -- stays on screen): the GUI's follow-up, its loading screen first, waits for the last question like everything else.
        -- This check ran 3 s after Bloxy started, saw no topbar question and no Confirm, and put the 2011 loading screen up
        -- in the middle of the setup's questions (the 2011 preset recording).
        local function setupOn()
            local wizard = getgenv().BPWizard
            return type(wizard) == "table" and type(wizard.deferring) == "function" and wizard.deferring() == true
        end
        if setupOn() then
            local wizard = getgenv().BPWizard
            if type(wizard.later) == "function" then
                wizard.later("loader: the GUI's follow-up", function()
                    if confirmSeen then return end
                    task.spawn(evaluateAndLoad)
                    for _, delay in ipairs({ 0.5, 2, 4, 8 }) do
                        task.delay(delay, function() if not confirmSeen then evaluateAndLoad() end end)
                    end
                end, true)
            end
            print("[Loader] the setup is still being answered: the GUI's follow-up waits for the last question")
            return
        end
        print("[Loader] Bloxy loaded its saved topbar without a Confirm: following it")
        -- a More guis pick put back at the start: its era (2015 early, 2008, 2006, 2005 save another year)
        if restoredTopbarPick and not confirmedVariant then
            confirmedVariant = TOPBAR_VARIANTS[restoredTopbarPick]
                or PENDING_VARIANTS[MORE_GUIS_PICKS[restoredTopbarPick] and MORE_GUIS_PICKS[restoredTopbarPick].pending or ""]
            confirmedVariantName = confirmedVariant and restoredTopbarPick or nil
        end
        for _, delay in ipairs({ 0, 2, 4 }) do
            task.delay(delay, function()
                if not confirmSeen and not setupOn() then evaluateAndLoad() end
            end)
        end
    end)
end)

--========================================================
-- 2006 / 2008 / 2010 GUIS: THE INVENTORY RIGHT ON THE CHAT BAR, AND 2010'S "HEALTH"
-- * Their inventory (ClassicBackpack) sat 2 pixels above the chat bar (room for the green outline of the tool in
--   hand, drawn just outside its slot). It now sits right on the bar, and the outline is drawn just inside the
--   slot: whole (not cut off by the bar) and over nothing. The same for the 2006 gist, the 2008 GUI, the new 2010
--   GUI and Bloxy's own 2010: they share this inventory and chat bar. 2005 (no inventory) and 2011 (another GUI)
--   are not touched. (An earlier copy put the bar over the inventory; with these GUIs' Global layering that hid
--   the 2008 bar's own "To chat click here" text: a bar left like that gets its text back on top.)
-- * 2010 (the new GUI and Bloxy's own): "Health" under the health bar is as big as the player list's text (18, was
--   14) and the colour it has in a 2010 client screenshot the user gave: a medium blue with a slight purple tint
--   (53, 54, 172, the middle of the text's pixels there). The GUI's own (0, 100, 255) was a lighter, greener blue.
--   Only the text: the bar stays as it was. The 2006 and 2008 ones are their own and are left alone.
-- * 2010: the player list's text all one size, as in the 2010 client (a screenshot of it): the names were 14, the
--   numbers 18, the team rows 12 / 16 and the headers 14. All 18 now, the size of the numbers (its rows are 18 high).
-- * 2010: the Report / screenshot / camera buttons (bottom right) moved down so the camera buttons sit right
--   above the chat bar (2 px), as in the 2010 client (they were about 30 px above it).
--========================================================
if getgenv().BPChatGapCleanup then
    pcall(getgenv().BPChatGapCleanup)
    getgenv().BPChatGapCleanup = nil
end
do
    local conns = {}
    local HEALTH_TEXT_SIZE = 18
    local HEALTH_TEXT_COLOR = Color3.fromRGB(53, 54, 172) -- (measured on the 2010 screenshot)
    local LIST_TEXT_SIZE = 18 -- 2010's player list: every text this size (the size of its numbers)
    local PALETTE_GAP = 2      -- 2010's camera buttons this far above the chat bar

    local function bottomAnchored(obj)
        return obj.AnchorPoint.Y == 1 and obj.Position.Y.Scale == 1 and obj.Size.Y.Scale == 0
    end

    -- the green outline of the tool in hand drawn just inside its slot (it was drawn just outside it)
    local function insetOutline(slot)
        local sel = slot:FindFirstChild("SelectionFrame")
        if not (sel and sel:IsA("GuiObject")) then return end
        local stroke = sel:FindFirstChildOfClass("UIStroke")
        local t = (stroke and stroke.Thickness) or 2
        sel.Size = UDim2.new(1, -2 * t, 1, -2 * t)
        sel.Position = UDim2.new(0, t, 0, t)
    end

    -- "Global" layering: a bar drawn over its own text (an earlier copy of this fix, or the 2008 GUI, raised the bar
    -- only): the text and the typing box back on top of it, in their own order
    local function barTextOnTop(bar)
        local items, low = {}, math.huge
        for _, d in ipairs(bar:GetDescendants()) do
            if d:IsA("GuiObject") then
                table.insert(items, d)
                if d.ZIndex < low then low = d.ZIndex end
            end
        end
        if #items > 0 and low < bar.ZIndex then
            local shift = bar.ZIndex - low
            for _, o in ipairs(items) do o.ZIndex = o.ZIndex + shift end
        end
    end

    -- true once the inventory is placed (or was already)
    local function closeGap(gui)
        local bar = gui:FindFirstChild("ClassicBottomChatBar")
        local pack = gui:FindFirstChild("ClassicBackpack")
        if not (bar and pack and bar:IsA("GuiObject") and pack:IsA("GuiObject")) then return false end
        local global = false
        pcall(function() global = gui.ZIndexBehavior == Enum.ZIndexBehavior.Global end)
        if global then barTextOnTop(bar) end
        -- only the layout these GUIs have: both held by their bottom edge, the bar at the very bottom
        if not (bottomAnchored(bar) and bar.Position.Y.Offset == 0 and bottomAnchored(pack)) then return true end
        local x = pack.Position.X
        local bottom = -bar.Size.Y.Offset -- the top of the bar
        if pack.Position.Y.Offset ~= bottom then
            pack.Position = UDim2.new(x.Scale, x.Offset, 1, bottom)
        end
        for _, slot in ipairs(pack:GetChildren()) do insetOutline(slot) end
        -- (the slots are made after the inventory is put on screen)
        table.insert(conns, pack.ChildAdded:Connect(insetOutline))
        return true
    end

    -- 2010's "Health" text: ArialBold 14 in (0, 100, 255). true once the frame has its "Health" text (2010's
    -- changed; 2006's and 2008's, which are made another way, left alone)
    local function fixHealthText(frame)
        for _, label in ipairs(frame:GetChildren()) do
            if label:IsA("TextLabel") and label.Text == "Health" then
                local c = label.TextColor3
                local is2010 = label.Font == Enum.Font.ArialBold and label.TextSize == 14
                    and math.floor(c.R * 255 + 0.5) == 0 and math.floor(c.G * 255 + 0.5) == 100
                    and math.floor(c.B * 255 + 0.5) == 255
                if is2010 then
                    label.TextSize = HEALTH_TEXT_SIZE
                    label.TextColor3 = HEALTH_TEXT_COLOR
                    -- (a box the bigger text fits in, still centred under the bar)
                    local half = frame.Size.X.Offset / 2
                    label.Size = UDim2.new(0, 64, 0, 20)
                    label.Position = UDim2.new(0, half - 32, 1, 3)
                end
                return true
            end
        end
        return false
    end

    -- 2010's player list: every text label in it the same size, kept when the list writes its own size again
    -- (it does on every update)
    local listLabels = setmetatable({}, { __mode = "k" })
    local function sizeListLabel(label)
        if listLabels[label] or not label:IsA("TextLabel") then return end
        listLabels[label] = true
        local function apply()
            if label.TextSize ~= LIST_TEXT_SIZE then label.TextSize = LIST_TEXT_SIZE end
        end
        apply()
        table.insert(conns, label:GetPropertyChangedSignal("TextSize"):Connect(apply))
    end
    -- true once the list is watched
    local function watchList(gui)
        local list = gui:FindFirstChild("ClassicPlayerList")
        if not (list and list:IsA("GuiObject")) then return false end
        for _, d in ipairs(list:GetDescendants()) do sizeListLabel(d) end
        table.insert(conns, list.DescendantAdded:Connect(function(d) pcall(sizeListLabel, d) end))
        return true
    end

    -- 2010's Report / screenshot / camera group (RightPalette, held by its bottom edge): moved down so its camera
    -- buttons sit PALETTE_GAP above the chat bar. true once placed (or not this GUI's layout)
    local function movePalette(gui)
        local palette = gui:FindFirstChild("RightPalette")
        local bar = gui:FindFirstChild("ClassicBottomChatBar")
        if not (palette and bar) then return false end
        local camera = palette:FindFirstChild("CameraPanel")
        if not camera then return false end
        if not (palette:IsA("GuiObject") and bar:IsA("GuiObject") and camera:IsA("GuiObject")) then return true end
        if not (bottomAnchored(palette) and bottomAnchored(bar) and bar.Position.Y.Offset == 0) then return true end
        -- (the empty room under the camera buttons, inside the group)
        local slack = palette.Size.Y.Offset - (camera.Position.Y.Offset + camera.Size.Y.Offset)
        local want = -(bar.Size.Y.Offset + PALETTE_GAP) + slack
        local p = palette.Position
        if p.Y.Offset ~= want then palette.Position = UDim2.new(p.X.Scale, p.X.Offset, 1, want) end
        return true
    end

    local function watchGui(gui)
        if gui.Name ~= "Classic2010Gui" or not gui:IsA("LayerCollector") then return end
        local gapDone, healthDone, healthWatch = false, false, nil
        local listDone, paletteDone, paletteWatch = false, false, nil
        local function check()
            if not gapDone then gapDone = closeGap(gui) end
            if not listDone then listDone = watchList(gui) end
            if not paletteDone then
                paletteDone = movePalette(gui)
                local palette = gui:FindFirstChild("RightPalette")
                if not paletteDone and palette and not paletteWatch then
                    -- the group is put on screen before its camera buttons are made
                    paletteWatch = palette.ChildAdded:Connect(function()
                        if paletteWatch and not paletteDone then
                            paletteDone = movePalette(gui)
                            if paletteDone then
                                paletteWatch:Disconnect()
                                paletteWatch = nil
                            end
                        end
                    end)
                    table.insert(conns, paletteWatch)
                end
            end
            if not healthDone and not healthWatch then
                local frame = gui:FindFirstChild("ClassicHealthFrame")
                if frame then
                    if fixHealthText(frame) then
                        healthDone = true
                    else
                        -- the frame is put on screen before its text is made
                        healthWatch = frame.ChildAdded:Connect(function()
                            if healthWatch and fixHealthText(frame) then
                                healthDone = true
                                healthWatch:Disconnect()
                                healthWatch = nil
                            end
                        end)
                        table.insert(conns, healthWatch)
                    end
                end
            end
            return gapDone and listDone and (paletteDone or paletteWatch ~= nil) and (healthDone or healthWatch ~= nil)
        end
        if check() then return end
        -- the GUI is put on screen empty and filled afterwards (the chat bar comes before the inventory)
        local conn
        conn = gui.ChildAdded:Connect(function()
            if conn and check() then
                conn:Disconnect()
                conn = nil
            end
        end)
        table.insert(conns, conn)
    end

    -- where these GUIs are put: gethui() when the executor has it, CoreGui when not
    local containers, seen = {}, {}
    pcall(function()
        if type(gethui) == "function" then table.insert(containers, gethui()) end
    end)
    pcall(function() table.insert(containers, game:GetService("CoreGui")) end)
    for _, container in ipairs(containers) do
        if typeof(container) == "Instance" and not seen[container] then
            seen[container] = true
            pcall(function()
                for _, child in ipairs(container:GetChildren()) do
                    pcall(watchGui, child)
                end
                table.insert(conns, container.ChildAdded:Connect(function(child)
                    pcall(watchGui, child)
                end))
            end)
        end
    end
    getgenv().BPChatGapCleanup = function()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        table.clear(conns)
    end
end

--========================================================
-- OLD SOUNDS: THE OOF WHEN YOU DIE
-- Bloxy's "old sounds" swaps the character's sounds for its own (ParadoxStep, ParadoxJump, ParadoxDeath...) and
-- removes Roblox's, so the death sound was Bloxy's (rbxassetid://17755696142), not the classic oof. The oof is
-- Roblox's own default death sound again since 31 July 2025, and Roblox put it in the Creator Store ("Official OOF
-- Sound Effect", asset 79348298352567). It is loaded ahead and played here the moment you die. If it doesn't load,
-- Roblox's own default death sound file is used instead (the oof again since then).
-- (It used to play only when Bloxy's ParadoxDeath sound was sitting in the root part at the moment of death, and in
-- some games, or when the sound pack put its sounds somewhere else, or only made that sound as you died, it never did:
-- the user's "restore the oof". Now "old sounds" is known three ways: the answer Bloxy keeps in its settings file, any
-- of its sounds (Paradox...) or Hammer stuff 2's old avatar sounds (Custom_...) in the character; any one is enough.
-- The oof is played from the SoundService, so it still plays when the game removes the character the moment you die.)
--========================================================
task.spawn(function()
    local OOF = "rbxassetid://79348298352567"
    local OOF_FALLBACK = "rbxasset://sounds/uuhhh.mp3"
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    if not player then return end
    local ContentProvider = game:GetService("ContentProvider")
    local SoundService = game:GetService("SoundService")
    local HttpService = game:GetService("HttpService")
    -- the oof, loaded ahead (a sound that isn't loaded yet when you die plays nothing)
    local oofSound = Instance.new("Sound")
    oofSound.Name = "BPOldOof"
    oofSound.SoundId = OOF
    oofSound.Volume = 0.65
    oofSound.Parent = SoundService
    local oofFailed = false
    task.spawn(function()
        pcall(function() ContentProvider:PreloadAsync({ oofSound }) end)
        task.wait(4)
        if not oofSound.IsLoaded then oofFailed = true oofSound.SoundId = OOF_FALLBACK end
    end)

    local function isPackSound(inst)
        if not inst:IsA("Sound") then return false end
        local n = inst.Name
        return string.sub(n, 1, 7) == "Paradox" or string.sub(n, 1, 7) == "Custom_"
    end
    local function oldSoundsOn(character)
        -- 1. Bloxy's own answer to "old sounds", in its settings file
        local okCfg, on = pcall(function()
            if isfile and readfile and isfile("BloxyParadoxConfig.json") then
                local cfg = HttpService:JSONDecode(readfile("BloxyParadoxConfig.json"))
                return type(cfg) == "table" and type(cfg.Choices) == "table" and cfg.Choices.Sounds == true
            end
            return false
        end)
        if okCfg and on then return true end
        -- 2. the sound pack itself in the character
        for _, d in ipairs(character:GetDescendants()) do
            if isPackSound(d) then return true end
        end
        return false
    end
    -- (Bloxy's own death sound is kept quiet: the oof is played instead, so it is never missed or doubled)
    local function quietDeathSound(sound)
        if not (sound:IsA("Sound") and sound.Name == "ParadoxDeath") then return end
        sound.SoundId = OOF
        sound.Volume = 0
    end
    local said = false
    local function playOof(character)
        for _, d in ipairs(character:GetDescendants()) do
            if d:IsA("Sound") and (d.Name == "ParadoxDeath" or d.Name == "Died") then
                pcall(function() d.Volume = 0 d:Stop() end)
            end
        end
        pcall(function()
            local s = oofSound:Clone()
            if not oofSound.IsLoaded then s.SoundId = OOF_FALLBACK end
            s.Parent = SoundService
            s:Play()
            game:GetService("Debris"):AddItem(s, 5)
        end)
        if not said then
            said = true
            print("[Loader] old sounds: the oof played" .. ((oofFailed or not oofSound.IsLoaded) and " (Roblox's own death sound file: the oof asset didn't load)" or ""))
        end
    end
    local function watch(character)
        local root = character:WaitForChild("HumanoidRootPart", 10)
        local humanoid = character:WaitForChild("Humanoid", 10)
        if not (root and humanoid) then return end
        for _, child in ipairs(root:GetChildren()) do pcall(quietDeathSound, child) end
        root.ChildAdded:Connect(function(child) pcall(quietDeathSound, child) end)
        local played = false
        local function died()
            if played then return end
            if not oldSoundsOn(character) then return end
            played = true
            playOof(character)
        end
        humanoid.Died:Connect(died)
        -- (and from the health, for a game that takes the health to nothing a different way)
        humanoid.HealthChanged:Connect(function(health) if health <= 0 then died() end end)
    end
    if player.Character then task.spawn(watch, player.Character) end
    player.CharacterAdded:Connect(watch)
end)

