local LIMITER_PATTERN =
    'table%.insert%(lim%.connections, RunService%.Stepped:Connect%(function%(%)%s*'
    .. 'if lim%.isUpdating then return end%s*'
    .. 'for _, desc in ipairs%(workspace:GetDescendants%(%)%) do%s*'
    .. 'if desc:IsA%("BasePart"%) and not isValidColor%(desc%) then%s*'
    .. 'snapPart%(desc%)%s*end%s*end%s*end%)%)'
local LIMITER_REPLACEMENT = [==[
-- (sliced) the parts are listed once and kept up to date; each physics step checks a slice of them
local trackedParts, trackedSlot, sliceCursor = {}, {}, 1
local function trackPart(part)
    if not trackedSlot[part] and part:IsA("BasePart") then
        trackedParts[#trackedParts + 1] = part
        trackedSlot[part] = #trackedParts
    end
end
local function untrackPart(part)
    local at = trackedSlot[part]
    if not at then return end
    local last = trackedParts[#trackedParts]
    trackedParts[at] = last
    trackedSlot[last] = at
    trackedParts[#trackedParts] = nil
    trackedSlot[part] = nil
end
for _, desc in ipairs(workspace:GetDescendants()) do trackPart(desc) end
table.insert(lim.connections, workspace.DescendantAdded:Connect(trackPart))
table.insert(lim.connections, workspace.DescendantRemoving:Connect(untrackPart))
table.insert(lim.connections, RunService.Stepped:Connect(function()
    if lim.isUpdating then return end
    local total = #trackedParts
    if total == 0 then return end
    local deadline = os.clock() + 0.0012
    local checked = 0
    while checked < total do
        if sliceCursor > total then sliceCursor = 1 end
        local part = trackedParts[sliceCursor]
        sliceCursor = sliceCursor + 1
        checked = checked + 1
        if part and not isValidColor(part) then snapPart(part) end
        if checked % 40 == 0 and os.clock() > deadline then break end
    end
end))
]==]

-- More guis: the report button check
local DEDUPE_PATTERN = 'task%.wait%(0%.2%)(%s*)pcall%(dedupe%)'

local function applySpeedups(src)
    for _, edit in ipairs(SPEEDUPS_PLAIN) do
        src = replacePlain(src, edit[1], edit[2])
    end
    src = string.gsub(src, LIMITER_PATTERN, function() return LIMITER_REPLACEMENT end)
    src = string.gsub(src, DEDUPE_PATTERN, function(gap) return "task.wait(0.6)" .. gap .. "pcall(dedupe)" end)
    return src
end

-- patch (optional): changes the downloaded code before it runs (the speed-ups above always apply)
local function loadUrl(url, label, patch)
    local ok, src = pcall(game.HttpGet, game, url)
    if not ok or type(src) ~= "string" then return false, "download" end
    if patch then src = patch(src) end
    src = applySpeedups(src)
    local chunk = loadstring(src)
    if not chunk then return false end
    return pcall(chunk)
end

