--========================================================
-- SPEED-UPS FOR THE GISTS
-- A few of the gists go through Bloxy's whole GUI on every frame, or through the whole workspace
-- on every physics step, for as long as the game runs. That is what made the game lag with a lot
-- of features on. They are changed here, in the text that is downloaded, just before it runs (the
-- gists themselves stay as they are). Each change only applies where the code it replaces is found,
-- so a gist that is swapped for a different one is simply left alone.
--   * Bloxy's setup questions are Frames in BloxyParadoxProject, and so is Bloxy's own panel
--     (HammerBigPanel, the hammer menu). That one is never a question and never goes away, yet
--     nine scripts searched all of it on every frame (Wizard smooth does not, in v10). They skip it now.
--   * Hammer stuff 2's 2005 / 2006 / 2012 colors went through every part of the workspace on every
--     physics step (tens of thousands of parts on a big map). The parts are now listed once, kept up
--     to date as they come and go, and each step checks a slice of about a millisecond, coming round
--     to every part again within a second or so.
--   * More guis' report button check ran five times a second; it now runs about twice a second.
--========================================================
local function replacePlain(src, old, new)
    local pieces, from, count = {}, 1, 0
    while true do
        local a, b = string.find(src, old, from, true)
        if not a then break end
        table.insert(pieces, string.sub(src, from, a - 1))
        table.insert(pieces, new)
        from = b + 1
        count = count + 1
    end
    if count == 0 then return src, 0 end
    table.insert(pieces, string.sub(src, from))
    return table.concat(pieces), count
end

