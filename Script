            local data = hookedNPCs[dialog]
            if data and data.bb then setBubbleActive(data.bb, prompt, dialog) end

            dialogWrap.Visible = true
            displayNode(dialog, prompt)
        end

        local function hookDialog(dialog)
            if not dialog or not dialog:IsA("Dialog") or dialog:GetAttribute("ClassicHooked") == SESSION_ID then return end

            local head = dialog:FindFirstAncestorWhichIsA("BasePart")
            if not head then
                -- a Dialog put straight into a Model: use that model's head / main part
                local model = dialog:FindFirstAncestorWhichIsA("Model")
                if model then
                    local h = model:FindFirstChild("Head")
                    head = (h and h:IsA("BasePart") and h) or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
                end
            end
            if not head then task.delay(1, function() hookDialog(dialog) end) return end

            dialog:SetAttribute("ClassicHooked", SESSION_ID)

            -- Where the icon sits. A Dialog inside an NPC shows over the NPC's head; anything
            -- else shows over the top of its part (not its centre: a big part's centre can be
            -- down in the floor, and the floor then hides the icon).
            local anchor = head
            local npc = head:FindFirstAncestorWhichIsA("Model")
            while npc do
                if npc:FindFirstChildOfClass("Humanoid") then
                    local npcHead = npc:FindFirstChild("Head")
                    if npcHead and npcHead:IsA("BasePart") then anchor = npcHead end
                    break
                end
                npc = npc:FindFirstAncestorWhichIsA("Model")
            end

            local origDist = dialog:GetAttribute("OrigDist")
            if not origDist then
                origDist = dialog.ConversationDistance
                dialog:SetAttribute("OrigDist", origDist)
            end
            pcall(function() dialog.ConversationDistance = 0 end)

            dialogCounter = dialogCounter + 1
            local bbName = "ClassicExecutorDialogGui_" .. dialogCounter

            local tone = getTone(dialog)

            local bb = Instance.new("BillboardGui")
            bb.Name = bbName
            bb.Adornee = anchor
            bb.Size = UDim2.new(0, 46, 0, 60)
            -- the icon's bottom sits 1 stud above the top of the anchor part
            bb.ExtentsOffsetWorldSpace = Vector3.new(0, 1, 0)
            bb.StudsOffsetWorldSpace = Vector3.new(0, 1, 0)
            bb.SizeOffset = Vector2.new(0, 0.5)
            bb.AlwaysOnTop = false
            bb.Active = true
            bb.MaxDistance = math.huge
            bb:SetAttribute("ClassicOwned", true)
            bb.Parent = ensureHost()
            bb:SetAttribute("IsInDialog", false)

            local iconBubble = Instance.new("ImageLabel")
            iconBubble.Name = "IconBubble"
            iconBubble.Size = UDim2.new(1, 0, 1, 0)
            iconBubble.BackgroundTransparency = 1
            iconBubble.Image = OVERHEAD_ICONS[tone] or OVERHEAD_ICONS.Neutral
            iconBubble.ScaleType = Enum.ScaleType.Fit
            iconBubble.ZIndex = 1
            iconBubble.Visible = true
            iconBubble.Parent = bb

            local clickBtn = Instance.new("TextButton")
            clickBtn.Size = UDim2.new(1, 0, 1, 0)
            clickBtn.BackgroundTransparency = 1
            clickBtn.Text = ""
            clickBtn.ZIndex = 10
            clickBtn.Parent = iconBubble

            clickBtn.MouseButton1Click:Connect(function()
                local char = LocalPlayer.Character
                local myHead = char and char:FindFirstChild("Head")
                if not myHead then return end

                local dist = (myHead.Position - head.Position).Magnitude
                local maxDist = dialog:GetAttribute("OrigDist") or 25
                if dist <= maxDist then
                    startDialog(dialog, head)
                end
            end)

            local pStr = dialog.Purpose and enumLeaf(dialog.Purpose) or "Help"
            local purposeIcon = Instance.new("ImageLabel")
            purposeIcon.Name = "PurposeIcon"
            purposeIcon.Size = UDim2.new(0, 28, 0, 28)
            purposeIcon.Position = UDim2.new(0.5, -14, 0, 4)
            purposeIcon.BackgroundTransparency = 1
            purposeIcon.Image = PURPOSE_ICONS[pStr] or PURPOSE_ICONS.Help
            purposeIcon.ScaleType = Enum.ScaleType.Fit
            purposeIcon.ZIndex = 3
            purposeIcon.Visible = true
            purposeIcon.Parent = iconBubble

            local textFrame = Instance.new("ImageLabel")
            textFrame.Name = "TextBubble"
            textFrame.Size = UDim2.new(1, 0, 1, 0)
            textFrame.BackgroundTransparency = 1
            textFrame.Image = TONE_BACKGROUNDS[tone] or TONE_BACKGROUNDS.Neutral
            textFrame.ScaleType = Enum.ScaleType.Slice
            textFrame.SliceCenter = Rect.new(16, 16, 16, 16)
            textFrame.SliceScale = 0.55
            textFrame.ZIndex = 2
            textFrame.Visible = false
            textFrame.Parent = bb

            local bubbleText = Instance.new("TextLabel")
            bubbleText.Name = "BubbleText"
            bubbleText.Size = UDim2.new(1, -24, 1, -16)
            bubbleText.Position = UDim2.new(0, 12, 0, 8)
            bubbleText.BackgroundTransparency = 1
            bubbleText.TextColor3 = Color3.fromRGB(255, 255, 255)
            bubbleText.TextSize = 16
            bubbleText.Font = Enum.Font.SourceSans
            bubbleText.TextWrapped = true
            bubbleText.ZIndex = 3
            bubbleText.Parent = textFrame

            local bubbleTail = Instance.new("ImageLabel")
            bubbleTail.Name = "BubbleTail"
            bubbleTail.BackgroundTransparency = 1
            bubbleTail.Image = TONE_TAILS_BOTTOM[tone] or TONE_TAILS_BOTTOM.Neutral
            bubbleTail.ScaleType = Enum.ScaleType.Fit
            bubbleTail.Size = UDim2.new(0, 22, 0, 22)
            bubbleTail.AnchorPoint = Vector2.new(0.5, 0)
            bubbleTail.Visible = false
            bubbleTail.ZIndex = 3
            bubbleTail.Parent = bb

            hookedNPCs[dialog] = { head = head, bb = bb }
            needNativeSweep = true

            local stepConn
            stepConn = RunService.RenderStepped:Connect(function()
                if not head.Parent or not dialog.Parent then
                    if bb.Parent then bb:Destroy() end
                    hookedNPCs[dialog] = nil
                    stepConn:Disconnect()
                    return
                end

                if not bb.Parent or not bb:IsDescendantOf(game) or not anchor.Parent then
                    dbg("icon (or the NPC head it sits on) was removed, re-hooking")
                    if bb.Parent then bb:Destroy() end
                    stepConn:Disconnect()
                    hookedNPCs[dialog] = nil
                    dialog:SetAttribute("ClassicHooked", nil)
                    task.defer(function() hookDialog(dialog) end)
                    return
                end

                if bb:GetAttribute("IsInDialog") == true then return end

                local cam = Workspace.CurrentCamera
                if not cam then return end

                local dist = (cam.CFrame.Position - anchor.Position).Magnitude
                local zoom = math.clamp(30 / math.max(dist, 3), 0.1, 2.5)
                local storedZoom = bb:GetAttribute("CurrentZoom") or -1

                if math.abs(zoom - storedZoom) > 0.05 then
                    bb:SetAttribute("CurrentZoom", zoom)
                    bb.Size = UDim2.new(0, 46 * zoom, 0, 60 * zoom)
                    purposeIcon.Size = UDim2.new(0, 28 * zoom, 0, 28 * zoom)
                    purposeIcon.Position = UDim2.new(0.5, -(28 * zoom / 2), 0, 4 * zoom)
                end
            end)
            table.insert(connections, stepConn)
        end

        local function isHookedHead(part)
            if not part then return false end
            for _, data in pairs(hookedNPCs) do
                if data.head == part then return true end
            end
            return false
        end

        -- Roblox's / the game's own dialog icons over the NPCs hooked here are switched off the
        -- moment they show up, and again if the game switches them back on. This used to look
        -- through all of PlayerGui and CoreGui five times a second, which slowed the game down.
        local function suppressNative(obj)
            if obj.ClassName ~= "BillboardGui" or disabledNative[obj] or not obj.Parent then return end
            if obj:GetAttribute("ClassicOwned") then return end
            if billboardHost and obj:IsDescendantOf(billboardHost) then return end
            if not (isHookedHead(obj.Adornee) or isHookedHead(obj.Parent)) then return end
            local wasOn = obj.Enabled
            pcall(function() obj.Enabled = false end)
            local keepOff = obj:GetPropertyChangedSignal("Enabled"):Connect(function()
                if alive and obj.Enabled then pcall(function() obj.Enabled = false end) end
            end)
            disabledNative[obj] = { keepOff = keepOff, restore = wasOn }
        end

        -- the icons that already exist (and, once, every few seconds, in case one was missed)
        local function sweepNative()
            needNativeSweep = false
            for _, data in pairs(hookedNPCs) do
                if data.head then
                    for _, obj in ipairs(data.head:GetChildren()) do suppressNative(obj) end
                end
            end
            for _, container in ipairs({ pg, CoreGui }) do
                pcall(function()
                    for _, obj in ipairs(container:GetDescendants()) do suppressNative(obj) end
                end)
            end
        end

        -- icons that appear later are caught as they are added
        for _, container in ipairs({ pg, CoreGui }) do
            pcall(function()
                table.insert(connections, container.DescendantAdded:Connect(function(obj)
                    if obj.ClassName ~= "BillboardGui" then return end
                    -- its Adornee is often set a moment after it is parented
                    task.defer(suppressNative, obj)
                    task.delay(0.5, suppressNative, obj)
                end))
            end)
        end

        -- every second: the dialog GUIs are put back if they were removed, and the icons on the
        -- NPC heads are looked at (a few parts, not the whole GUI)
        task.spawn(function()
            local sinceFullSweep = 0
            while alive do
                pcall(ensureHost)
                for _, g in ipairs({ gui, noticeGui }) do
                    if not g.Parent then pcall(function() g.Parent = parentGui end) end
                end
                sinceFullSweep = sinceFullSweep + 1
                if needNativeSweep or sinceFullSweep >= 10 then
                    sinceFullSweep = 0
                    pcall(sweepNative)
                else
                    for _, data in pairs(hookedNPCs) do
                        if data.head then
                            for _, obj in ipairs(data.head:GetChildren()) do suppressNative(obj) end
                        end
                    end
                end
                -- icons that no longer exist are forgotten
                for obj, state in pairs(disabledNative) do
                    if not obj.Parent then
                        pcall(function() state.keepOff:Disconnect() end)
                        disabledNative[obj] = nil
                    end
                end
                task.wait(1)
            end
        end)

        -- walking away from the NPC you are talking to ends the chat
        table.insert(connections, RunService.RenderStepped:Connect(function()
            if not activeNPC or not activeDialog then return end

            local char = LocalPlayer.Character
            local myHead = char and char:FindFirstChild("Head")

            local maxDist = 25
            pcall(function()
                local orig = activeDialog:GetAttribute("OrigDist")
                if type(orig) == "number" and orig > 0 then maxDist = orig end
            end)

            if not myHead or not activeNPC.Parent or (myHead.Position - activeNPC.Position).Magnitude > (maxDist + 5) then
                showSystemNotice("Chat ended because you walked away", 2.5)
                endDialog()
            end
        end))

        local function scanContainer(c)
            pcall(function()
                for _, d in ipairs(c:GetDescendants()) do
                    if d:IsA("Dialog") then hookDialog(d) end
                end
            end)
        end

        scanContainer(Workspace)
        table.insert(connections, Workspace.DescendantAdded:Connect(function(d)
            local class = d.ClassName
            if class == "Dialog" then
                task.defer(function() hookDialog(d) end)
            elseif class == "BillboardGui" then
                -- an icon the game put on an NPC's head
                task.defer(suppressNative, d)
            end
        end))

        getgenv().ClassicDialogCleanup = function()
            alive = false
            dialogGeneration = dialogGeneration + 1
            activeNPC, activeDialog = nil, nil
            pcall(function() gui:Destroy() end)
            pcall(function() billboardHost:Destroy() end)
            pcall(function() noticeGui:Destroy() end)
            for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end

            for dialog, data in pairs(hookedNPCs) do
                pcall(function()
                    dialog:SetAttribute("ClassicHooked", nil)
                    local orig = dialog:GetAttribute("OrigDist")
                    if orig then
                        dialog.ConversationDistance = orig
                        dialog:SetAttribute("OrigDist", nil)
                    end
                end)
            end
            for obj, state in pairs(disabledNative) do
                pcall(function() state.keepOff:Disconnect() end)
                if state.restore then pcall(function() obj.Enabled = true end) end
            end
            disabledNative = {}
            hookedNPCs = {}
            dialogLoaded_Classic = false
        end

        dialogLoaded_Classic = true
    end

    -- Picks that More guis adds press one of Bloxy's own buttons for you, so Bloxy saves that
    -- year instead ("2015 early" saves "2014", "2008", "2006" and "2005" save "2013"). At Confirm they are
    -- told apart by what the topbar list shows ("2015 early  ▼"); only when the list can't be
    -- read, by the More guis pick that is still waiting to load. Bloxy's own "2010" is listed
    -- here too, so it is recognised whatever the saved config says.
    local TOPBAR_VARIANTS = {
        ["2015 early"] = "early2015",
        ["2010"]       = "y2010",
        ["2008"]       = "y2010", -- the 2010 GUI without chat bubbles: no bubbles of ours over it
        ["2006"]       = "y2006",
        ["2005"]       = "y2005",
    }
    local PENDING_VARIANTS = {
        ["2015early"] = "early2015",
        ["2008"]      = "y2010",
        ["2006"]      = "y2006",
        ["2005"]      = "y2005",
    }
    local confirmedVariant = nil     -- era of a More guis pick at the last Confirm, or nil
    local confirmedVariantName = nil
    local confirmSeen = false        -- the topbar Confirm was clicked since this script started

    local function topbarListText(confirmBtn)
        local frame = confirmBtn and confirmBtn.Parent
        if not frame then return nil end
        for _, d in ipairs(frame:GetChildren()) do
            if d:IsA("TextButton") and d ~= confirmBtn then
                local t = d.Text or ""
                if t:find("▼", 1, true) or t:find("▲", 1, true) then return t end
            end
        end
        return nil
    end

    local function cleanListText(text)
        text = string.lower(text or "")
        text = text:gsub("▼", ""):gsub("▲", "")
        return (text:gsub("^%s+", ""):gsub("%s+$", ""))
    end

    --========================================================
    -- NO DIALOG BUBBLES (2008)
    -- The "?" / "!" bubbles over NPCs are BillboardGuis: Roblox's own (CoreGui) and the ones the
    -- classic dialogs draw. Switched off and kept off while the 2008 GUI is the topbar, and put back
    -- as they were when another one is picked. Nothing is looked through repeatedly: the ones there
    -- are swept once, the ones that appear later are caught as they are added.
    --========================================================
    local function stopDialogBubbleHider()
        if getgenv().DialogBubbleHiderCleanup then pcall(getgenv().DialogBubbleHiderCleanup) end
    end

    local function startDialogBubbleHider()
        if getgenv().DialogBubbleHiderCleanup then return end   -- already on
        local hidden, connections = {}, {}
        local alive = true

        local function isDialogBubble(gui)
            local name = gui.Name
            if name == "ChatNotificationGui" or name == "PlayerDialogBubble"
               or string.find(name, "^ClassicExecutorDialogGui_") then
                return true
            end
            -- Roblox's bubble under some other name still has its dialog bubble pictures
            for _, child in ipairs(gui:GetDescendants()) do
                if child:IsA("ImageLabel") or child:IsA("ImageButton") then
                    local image = string.lower(child.Image)
                    if string.find(image, "dialog_purpose", 1, true) or string.find(image, "notify_bkg", 1, true) then
                        return true
                    end
                end
            end
            return false
        end

        local function hideBubble(gui)
            if not alive or hidden[gui] or gui.ClassName ~= "BillboardGui" or not gui.Parent then return end
            if gui:GetAttribute("ClassicOwned") and gui.Name ~= "PlayerDialogBubble" then return end  -- name tags etc.
            if not isDialogBubble(gui) then return end
            local entry = { was = gui.Enabled }
            pcall(function() gui.Enabled = false end)
            entry.conn = gui:GetPropertyChangedSignal("Enabled"):Connect(function()
                if alive and gui.Enabled then pcall(function() gui.Enabled = false end) end
            end)
            hidden[gui] = entry
        end

        for _, root in ipairs({ CoreGui, pg }) do
            pcall(function()
                for _, obj in ipairs(root:GetDescendants()) do
                    if obj.ClassName == "BillboardGui" then hideBubble(obj) end
                end
                table.insert(connections, root.DescendantAdded:Connect(function(obj)
                    if obj.ClassName ~= "BillboardGui" then return end
                    -- its pictures are put in a moment after it is parented
                    task.defer(hideBubble, obj)
                    task.delay(0.5, hideBubble, obj)
                end))
            end)
        end

        local function cleanup()
            alive = false
            for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
            connections = {}
            for gui, entry in pairs(hidden) do
                pcall(function() entry.conn:Disconnect() end)
                pcall(function() if gui.Parent then gui.Enabled = entry.was end end)
            end
            hidden = {}
            if getgenv().DialogBubbleHiderCleanup == cleanup then getgenv().DialogBubbleHiderCleanup = nil end
        end
        getgenv().DialogBubbleHiderCleanup = cleanup
        print("[Loader] no dialog bubbles over NPCs (2008)")
    end

    local function evaluateAndLoad()
        local era, raw = getSelectedEra()
        if confirmedVariant then
            era, raw = confirmedVariant, confirmedVariantName
        end
        print("[Loader] topbar choice \"" .. tostring(raw) .. "\" -> era: " .. era)
        getgenv().BloxyEra = era
        -- the bubble script each era runs (none for "none", 2015 early, 2010, 2006 and 2005)
        local bubbleEra = era
        if era == "none" or era == "early2015" or era == "y2010" or era == "y2006" or era == "y2005" then
            bubbleEra = nil
        end
        desiredBubbleEra = bubbleEra
        if bubbleEra and lastFailedEra == bubbleEra then lastFailedEra = nil end

        if era ~= "bubble2017" then
            -- leaving 2015 / 2016: the 2017 bubbles stop
            if activeBubbleEra == "bubble2017" then stopBubbleScript("bubble2017") end
            if getgenv().Bubble2017Cleanup then pcall(getgenv().Bubble2017Cleanup) end
        end

        -- The game's own (modern) speedometer only shows from 2015 on. Up to 2014 it is switched off:
        -- 2010-2014 get the old speedometer in its place, 2005 / 2006 have none.
        -- (the 2008 GUI of More guis is a "y2010" for the bubbles, but older than 2010: no speedometer)
        local is2008 = tostring(raw) == "2008"
        if not (is2008 and era == "y2010") then stopDialogBubbleHider() end
        if (era == "classic" or era == "y2010") and not is2008 then
            local ok, err = pcall(startSpeedometer, "show")
            if not ok then warn("[Loader] the speedometer didn't start: " .. tostring(err)) end
        elseif era == "y2006" or era == "y2005" or is2008 then
            local ok, err = pcall(startSpeedometer, "hideOnly")
            if not ok then warn("[Loader] the speedometer hider didn't start: " .. tostring(err)) end
        else
            stopSpeedometer()
        end

        if era == "none" then
            if getgenv().ClassicDialogCleanup then pcall(getgenv().ClassicDialogCleanup) end
            dialogLoaded_Classic = false
            setNativeBubbles(false)
            if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
            -- nothing selected: the 2017 bubbles must not stay on
            if getgenv().Bubble2017Cleanup then pcall(getgenv().Bubble2017Cleanup) end
            return
        end

        if era == "classic" then
            setNativeBubbles(true)
            task.spawn(startBubbleScript, "classic")
            if not dialogLoaded_Classic then
                dialogLoaded_Classic = true
                task.spawn(injectClassicDialogs)
            end

        elseif era == "bubble2017" then
            -- 2015 / 2016: the 2017 bubbles, with Roblox's own bubbles hidden the same way the
            -- classic bubbles hide them. If the 2017 bubbles can't start, the regular ones come back.
            setNativeBubbles(true)
            if getgenv().ClassicDialogCleanup then pcall(getgenv().ClassicDialogCleanup) end
            dialogLoaded_Classic = false
            task.spawn(startBubbleScript, "bubble2017")

        elseif era == "early2015" then
            -- 2015 early draws its own early 2015 chat bubbles, so no bubble script of ours runs
            -- (the classic one removed its bubbles, any other would add a second set), and
            -- Roblox's own bubbles stay off as for 2014. Dialogs are Roblox's default ones (their
            -- choice box is kept at the top of this script).
            setNativeBubbles(true)
            if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
            if getgenv().Bubble2017Cleanup then pcall(getgenv().Bubble2017Cleanup) end
            if getgenv().ClassicDialogCleanup then pcall(getgenv().ClassicDialogCleanup) end
            dialogLoaded_Classic = false

        elseif era == "y2010" and is2008 then
            -- 2008: like 2010 (its GUI draws no bubbles of ours, Roblox's own stay off), but no
            -- dialog bubbles over NPCs: the classic dialogs do not run, and the ones Roblox draws
            -- are switched off.
            setNativeBubbles(true)
            if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
            if getgenv().Bubble2017Cleanup then pcall(getgenv().Bubble2017Cleanup) end
            if getgenv().ClassicDialogCleanup then pcall(getgenv().ClassicDialogCleanup) end
            dialogLoaded_Classic = false
            startDialogBubbleHider()

        elseif era == "y2010" then
            -- 2010 draws its own chat bubbles (Retro2009ChatBubbles, in PlayerGui). The 2011-style
            -- bubble engine must not run: it removes every other bubble from the characters, which
            -- took the 2010 GUI's own away and drew ours instead. Roblox's own bubbles stay off
            -- (the 2010 GUI turns them off too). The classic dialogs stay as they were.
            setNativeBubbles(true)
            if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
            if getgenv().Bubble2017Cleanup then pcall(getgenv().Bubble2017Cleanup) end
            if not dialogLoaded_Classic then
                dialogLoaded_Classic = true
                task.spawn(injectClassicDialogs)
            end

        elseif era == "y2006" or era == "y2005" then
            -- 2006 and 2005: no chat bubbles, no NPC dialogs back then. Their GUIs hide Roblox's own
            -- dialog and chat bubbles (2006 saves as "2013" in Bloxy, which used to start the 2011
            -- bubbles over it), so neither the classic dialogs nor a bubble script of ours run.
            setNativeBubbles(true)
            if activeBubbleEra then stopBubbleScript(activeBubbleEra) end
            if getgenv().Bubble2017Cleanup then pcall(getgenv().Bubble2017Cleanup) end
            if getgenv().ClassicDialogCleanup then pcall(getgenv().ClassicDialogCleanup) end
            dialogLoaded_Classic = false

        elseif era == "modern" then
            setNativeBubbles(false)
            if getgenv().ClassicDialogCleanup then pcall(getgenv().ClassicDialogCleanup) end
            dialogLoaded_Classic = false
            task.spawn(startBubbleScript, "modern")
        end
    end

    -- Confirm: the era is read from the saved config. The config may be written a moment after
    -- the click, so it is read again a little later (the second reading changes nothing when the
    -- era is the same; it only fixes a reading that was taken before the config was saved).
    local function onConfirm(confirmBtn)
        -- read at the click: Bloxy removes the topbar question right after
        local listText = topbarListText(confirmBtn)
        if listText then
            local name = cleanListText(listText)
            confirmedVariant = TOPBAR_VARIANTS[name]
            confirmedVariantName = confirmedVariant and name or nil
        elseif confirmBtn:FindFirstAncestor("BloxyParadoxProject") then
            -- Bloxy's Confirm, but its list couldn't be read
            local pending = getgenv().BP_PendingTopbar
            confirmedVariant = pending and PENDING_VARIANTS[pending] or nil
            confirmedVariantName = confirmedVariant and pending or nil
        else
            return -- some other script's "confirm" button: not the topbar
        end
        confirmSeen = true
        for _, delay in ipairs({ 0.5, 2, 4 }) do
            task.delay(delay, evaluateAndLoad)
        end
    end

    -- Confirm buttons are hooked when they appear (or when a button in Bloxy's GUI is renamed
    -- "Confirm"). This used to look through all of PlayerGui four times a second, for as long as
    -- the game ran, which got slower the more GUI the game had.
    local function hookConfirm(obj)
        if obj:GetAttribute("BPHookedConfirm") then return end
        if not string.find(string.lower(obj.Text or ""), "confirm", 1, true) then return end
        obj:SetAttribute("BPHookedConfirm", true)
        obj.MouseButton1Click:Connect(function() onConfirm(obj) end)
    end

    local function watchButton(obj)
        -- looked at a moment later: the script that made it may still be setting its name and text
        task.defer(function()
            if not obj.Parent then return end
            hookConfirm(obj)
            if not obj:GetAttribute("BPHookedConfirm") and obj:FindFirstAncestor("BloxyParadoxProject") then
                obj:GetPropertyChangedSignal("Text"):Connect(function() hookConfirm(obj) end)
            end
        end)
    end

    if pg then
        for _, obj in ipairs(pg:GetDescendants()) do
            if obj.ClassName == "TextButton" then watchButton(obj) end
        end
        pg.DescendantAdded:Connect(function(obj)
            if obj.ClassName == "TextButton" then watchButton(obj) end
        end)
    end

    -- Bloxy can load the saved topbar without a Confirm click: with "skip setup" ticked it does
    -- so as it starts, and the topbar may also have been confirmed before this script was run.
    -- Then the bubbles and dialogs never followed it. Now, once Bloxy's GUI is up and its topbar
    -- question isn't on screen, the saved choice is followed too. (Picks that More guis adds
    -- can't be told apart there: Bloxy saved the year they press, and that is what it loaded.)
    local function topbarQuestionShown(sg)
        for _, d in ipairs(sg:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text == "Which topbar do you prefer?" then return true end
        end
        return false
    end

    task.spawn(function()
        local sg = pg:WaitForChild("BloxyParadoxProject", 300)
        if not sg then return end
        task.wait(3)
        if confirmSeen or topbarQuestionShown(sg) then return end
        print("[Loader] Bloxy loaded its saved topbar without a Confirm: following it")
        for _, delay in ipairs({ 0, 2, 4 }) do
            task.delay(delay, function()
                if not confirmSeen then evaluateAndLoad() end
            end)
        end
    end)
end)

print("[Loader] All scripts loaded.")
